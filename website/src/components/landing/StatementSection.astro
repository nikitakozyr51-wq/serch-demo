---
/**
 * Врез — кадр Pencil `l1JWhP`, 1440×648, сплошной `fg` во всю ширину экрана.
 *
 * Единственное тёмное место главной, и работает оно как удар: метка, два
 * предложения кеглем 52 и полоса из четырёх чисел. Иерархию внутри полосы
 * даёт прозрачность белого, а не размер: три числа приглушены до 80 %, а
 * четвёртое — то, ради которого блок и стоит, — чистый белый.
 *
 * Поле снизу 188, а не 140: в файле после полосы чисел стоит ещё распорка 48.
 * Это не описка перевода, а решение файла — врез снизу дышит шире, чем сверху.
 *
 * Телефон — кадр `F1N8hr` внутри «МОБАЙЛ · Главная» (`EDoek`), и это не та же
 * полоса поуже, а другая раскладка того же смысла. Поля 80 сверху и снизу,
 * заголовок берёт ступень 26, а четыре крупных числа превращаются в список из
 * четырёх строк по 48: слева слово 17/600, справа число 13/600, волосная линия
 * над списком и своя под каждой строкой. Подписи там свои, короткие
 * («Приходит за сутки · 1 240 объявлений»), а не десктопные предложения:
 * читать «объявлений по Петербургу приходит за сутки» в правой колонке
 * шириной 106 px нечем. Поэтому у каждой строки два набора слов, оба из файла.
 *
 * Иерархию на телефоне по-прежнему держит прозрачность: три строки приглушены,
 * четвёртая — та, ради которой блок и стоит, — чистая белая. В файле
 * приглушённые слово и число разведены на #FFFFFF80 и #FFFFFF8C; здесь оба
 * берут `on-dark-soft` (#ffffff8a). Разница между 80, 8a и 8C — меньше
 * процента прозрачности, а шестая ступень белого в палитре осталась бы
 * навсегда. Расхождение названо, а не спрятано.
 *
 * Разделители между колонками на десктопе ниже lg не нужны вовсе: там список,
 * а не ряд.
 */
const numbers = [
  {
    value: '1 240',
    caption: 'объявлений по Петербургу приходит за сутки',
    /** Ответ, ради которого стоит блок, набран чистым белым. */
    answer: false,
    /** Замер телефона: то же число другими словами. */
    phone: { word: 'Приходит за сутки', value: '1 240 объявлений' },
  },
  {
    value: '630',
    caption: 'дублей склеено: один объект под разными номерами',
    answer: false,
    phone: { word: 'Дубли объявлений', value: '630 склеено' },
  },
  {
    value: '419',
    caption: 'посредников отсеяно до того, как вы их увидели',
    answer: false,
    phone: { word: 'Посредники', value: '419 отсеяно' },
  },
  {
    value: '191',
    caption: 'объект от собственников остаётся. Столько вы увидите за сутки',
    answer: true,
    phone: { word: 'Собственники', value: '191 остался' },
  },
]
---

<section class="bg-fg py-20 lg:pt-35 lg:pb-47">
  {/* Reveal с шагом 120, а не 80: это высказывание, а не список. Метка, довод и
      полоса чисел выходят с расстановкой, как читается фраза; на 80 они
      сливаются в одно движение. Полоса чисел выходит целиком — это один довод,
      а не четыре карточки. Стаггер нумерует отрисованные узлы, поэтому список
      телефона и ряд десктопа не отнимают такт друг у друга: на каждой ширине
      один из них `display: none` и в очередь не попадает. */}
  <div class="site-container" data-rev-group data-rev-step="120">
    <p class="text-label font-semibold text-on-dark-mute">ЧТО ВЫ ПОКУПАЕТЕ НА САМОМ ДЕЛЕ</p>

    {/* Заголовок секции, а не декоративная надпись: в оглавлении страницы врез
        обязан стоять наравне с остальными блоками, поэтому h2, а не абзац.
        Ниже lg обе строки белые и текут одним абзацем — так в замере телефона. */}
    <h2 class="text-26 mt-8 max-w-[900px] font-semibold lg:text-52">
      <span class="text-on-dark lg:block">Восемь объявлений из десяти</span>{' '}
      <span class="text-on-dark lg:block lg:text-on-dark-soft">размещает не собственник</span>
    </h2>

    {/* Телефон: список пар «слово — число». Линий на одну больше, чем строк:
        над списком отдельная волосная линия (`Iajw9`), и у каждой из четырёх
        строк своя нижняя (`strokeWidth.bottom = 1`), включая последнюю. Это
        замер `NtoiF`, а не «рамка вокруг списка»: раньше здесь стояла одна
        верхняя линия, и три разделителя внутри списка пропадали. */}
    <ul class="mt-6 border-t border-line-on-dark lg:hidden">
      {
        numbers.map((item) => (
          <li class="flex h-12 items-center justify-between gap-3 border-b border-line-on-dark">
            <span
              class:list={[
                'text-17 font-semibold',
                item.answer ? 'text-on-dark' : 'text-on-dark-soft',
              ]}
            >
              {item.phone.word}
            </span>
            <span
              class:list={[
                'text-13 font-semibold',
                item.answer ? 'text-on-dark' : 'text-on-dark-soft',
              ]}
            >
              {item.phone.value}
            </span>
          </li>
        ))
      }
    </ul>

    {/* Десктоп: ряд из четырёх чисел через вертикальные волосные линии. */}
    <div class="mt-16 hidden lg:flex lg:gap-0">
      {
        numbers.map((item, index) => (
          <>
            {index > 0 && (
              <span class="hidden w-px shrink-0 self-stretch bg-line-on-dark lg:block" aria-hidden="true" />
            )}
            <div
              class:list={[
                'flex flex-1 flex-col gap-2.5',
                index === 0 ? 'lg:pr-8' : index === numbers.length - 1 ? 'lg:pl-8' : 'lg:px-8',
              ]}
            >
              <span
                class:list={[
                  'text-num-40 font-semibold',
                  item.answer ? 'text-on-dark' : 'text-on-dark-mute',
                ]}
              >
                {item.value}
              </span>
              <span
                class:list={[
                  'text-15 font-medium',
                  item.answer ? 'text-on-dark-strong' : 'text-on-dark-soft',
                ]}
              >
                {item.caption}
              </span>
            </div>
          </>
        ))
      }
    </div>
  </div>
</section>
