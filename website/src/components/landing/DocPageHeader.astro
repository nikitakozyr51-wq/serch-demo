---
/**
 * Заголовок документационной страницы — `g60m9i` на «Как это устроено».
 *
 * Это второй тип шапки страницы на сайте, и он отличается от первого экрана
 * не оформлением, а рангом: здесь H1 набран сороковой ступенью, а не
 * шестьдесят шестой. Документация не кричит, она объясняет, поэтому под
 * заголовком стоит прозаический абзац (интерлиньяж 1.6471), а не короткий лид.
 *
 * Нижняя линия — `line-2`, а не `hairline`: она отделяет шапку от тела
 * страницы, и это единственное место на сайте, где линия работает как граница
 * раздела, а не как разлиновка внутри блока.
 *
 * Телефон — «Заголовок страницы» в кадре `FPwxu`: поля 24 сверху и снизу
 * вместо 72 и 48, зазор 12 вместо 20, заголовок 26/600 вместо 40/600, лид
 * 15/500 вместо прозаического 17-го, а метка 11/600 вместо 12/600 — это две
 * законные ступени капслока, и мелкая стоит там, где метка повторяется от
 * страницы к странице.
 */
interface Props {
  /** Прописная метка над заголовком: раздел и дата обновления. */
  kicker: string
  title: string
  lead: string
  /**
   * Короткая редакция лида для 390.
   *
   * На кадре `FPwxu` лид переписан, а не перенесён: «от момента, когда его
   * опубликовали на площадке» становится «от публикации на площадке».
   * Без свойства обе ширины несут длинный вариант — и на телефоне он
   * занимает пять строк вместо трёх.
   */
  leadSm?: string
}

const { kicker, lead, leadSm, title } = Astro.props
---

<section class="border-b border-line-2 py-6 lg:pt-18 lg:pb-12">
  <div class="site-container flex flex-col gap-3 lg:gap-5" data-rev-group>
    <p class="text-label-sm font-semibold text-text-dense lg:text-label">{kicker}</p>
    <h1 class="text-26 max-w-[894px] font-semibold text-fg lg:text-40">{title}</h1>
    {
      leadSm ? (
        <>
          <p class="text-15 max-w-[690px] font-medium text-text-2 lg:hidden">{leadSm}</p>
          <p class="text-17-prose hidden max-w-[690px] font-medium text-text-2 lg:block">
            {lead}
          </p>
        </>
      ) : (
        <p class="text-15 max-w-[690px] font-medium text-text-2 lg:text-17-prose">{lead}</p>
      )
    }
  </div>
</section>
