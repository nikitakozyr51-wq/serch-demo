---
/**
 * Кнопка сайта. Собрана по компонентам Pencil `x5cd2F` (основная) и `ywUJL`
 * (вторичная): высота 48, поле по горизонтали 28, радиус-пилюля, метка 17/600
 * с интерлиньяжем 1.4118 и трекингом −0.3.
 *
 * Ступеней ровно две — 48/17 и 28/13, потому что лестница сайта закрыта
 * (см. `global.css`). Ранг несёт заливка, а не высота: обе ступени могут быть
 * и главным действием, и вторичным, разница только в масштабе места.
 *
 * Пилюлю получает только ступень 48: на сайте это призыв к действию, и форма
 * читается как «нажми меня». У ступени 28 радиус 8 — из пары «высота — радиус».
 *
 * Состояний наведения и нажатия у кнопок САЙТА в Pencil нет, но они есть на
 * доске `СИСТЕМА · Состояния контролов` (`nXleb`) у кнопки 48 кабинета, и
 * ступени взяты оттуда: покой `fg` → наведение `fg-hover` → нажатие
 * `fg-press`, выключенная уходит в `warm`. Правила живут одним набором в
 * `global.css` (`.ctl-*`), а не переписаны здесь утилитами: иначе ступень
 * пришлось бы менять в шести компонентах сразу.
 *
 * `ctl-dark` у основной кнопки — про кольцо фокуса, а не про заливку: на
 * графитовой кнопке графитовое кольцо сливается, поэтому между ними встаёт
 * зазор 2 px цветом `bg` (замер `r00Oo`, состояние «фокус»).
 */
interface Props {
  /** Ведёт ли кнопка куда-то. Без адреса рисуется <button>, а не ссылка. */
  href?: string
  label: string
  /** Ступень лестницы: 48 — призыв, 28 — мелкое действие в плотном месте. */
  size?: 48 | 28
  /**
   * Ранг: заливка `fg` — главное действие, обводка — вторичное,
   * `on-photo` — то же главное действие, но на фотографии, где графитовая
   * заливка тонет в завесе, поэтому цвета меняются местами (замер `mylzb`
   * в «Итоговом действии»: заливка #ffffff, метка #1e1e1e).
   */
  variant?: 'primary' | 'secondary' | 'on-photo'
  /** `full` — кнопка занимает всю ширину родителя (так стоит в плашках прайса). */
  width?: 'auto' | 'full'
  /**
   * Уплотнение метки и поля до lg. Ровно один случай на сайте — призыв в шапке.
   *
   * В файле призыв шапки набран 15/600 с полем 16 на телефоне (`AcWMe`) и
   * 15/600 с полем 20 на десктопе (`zB5U7`); от lg здесь по-прежнему стоит
   * ступень 48/17 с полем 28 — решение, объяснённое в `SiteHeader.astro`.
   * На телефоне ступень взять нельзя не из вкуса, а из арифметики: при 320 px
   * ширины экрана логотип 73 + призыв 201 + кнопка меню 44 = 318 при 280
   * доступных, то есть строка рвётся. Замер телефона даёт 161 вместо 201, и
   * ряд сходится ровно.
   */
  compact?: boolean
}

const {
  compact = false,
  href,
  label,
  size = 48,
  variant = 'primary',
  width = 'auto',
} = Astro.props

// `whitespace-nowrap`: метка кнопки не переносится никогда. Ступень 48 — это
// высота 48, а перенос метки превращает её в 72 и ломает пару «высота — радиус».
const base =
  'ctl inline-flex items-center justify-center whitespace-nowrap font-semibold transition-colors duration-150'

const steps = {
  48: 'h-site-lg px-site-lg-x rounded-full text-17',
  28: 'h-site-sm px-site-sm-x rounded-md text-13',
} as const

const variants = {
  primary: 'ctl-solid ctl-dark',
  secondary: 'ctl-outline border',
  // Отклик белой кнопки собран из тех же тёплых токенов, что и вторичная:
  // белое можно только притемнить, и притемняется оно в тёплую сторону,
  // а не в серую, иначе кнопка выпадает из палитры.
  'on-photo': 'ctl-light',
} as const

const classes = [
  base,
  steps[size],
  variants[variant],
  width === 'full' ? 'w-full' : '',
  compact ? 'text-15 px-4 lg:text-17 lg:px-site-lg-x' : '',
]
---

{
  href ? (
    <a class:list={classes} href={href}>
      {label}
    </a>
  ) : (
    <button class:list={classes} type="button">
      {label}
    </button>
  )
}
