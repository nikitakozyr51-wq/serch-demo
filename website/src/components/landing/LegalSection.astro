---
/**
 * Юридический контур — `IoKKI` на «Законе и данных». Тот же блок собирает
 * «О компании», «Контакты» и раздел «Три вывода» в блоге, поэтому он общий,
 * а не часть страницы.
 *
 * Поля 160 сверху и снизу — самый просторный ритм на сайте. Заголовок 40/600
 * по центру шириной 760, лид по центру шириной 690, между ними 20, до первой
 * строки — 72.
 *
 * Строки раздела передаются содержимым: у каждой страницы они свои, а справа
 * бывает артефакт, бывает пусто.
 *
 * Телефон — «Так это работает по закону» в кадре `RbWlq` и его двойники на
 * «Оферте» (`j1bD09`), «Политике» (`F8asuT`) и «Согласии» (`BA3aO`). Там у
 * раздела нет ни собственных полей, ни центрирования: тело страницы — одна
 * колонка с зазором 24, а раздел внутри неё — заголовок 20/600 и лид 15/500
 * через 8, оба по левому краю. Поэтому 160 и 72 живут только от lg, а на
 * телефоне секция отдаёт ритм телу страницы: 12 сверху и снизу складываются
 * с соседними в те самые 24.
 */
interface Props {
  title: string
  lead: string
}

const { lead, title } = Astro.props
---

<section class="py-3 lg:py-40">
  <div class="site-container flex flex-col gap-6 lg:items-center lg:gap-18">
    {/* Шапка и строки — две группы по 80. Строка контура это строка, а не
        карточка: шаг 120 растянул бы контур из шести строк на три четверти
        секунды сверх самого перехода. */}
    <div class="flex flex-col gap-2 lg:items-center lg:gap-5" data-rev-group>
      <h2 class="text-20 max-w-[760px] font-semibold text-fg lg:text-center lg:text-40">
        {title}
      </h2>
      <p class="text-15 max-w-[690px] font-medium text-text-2 lg:text-center lg:text-17-prose">
        {lead}
      </p>
    </div>

    <div class="flex w-full flex-col" data-rev-group>
      <slot />
    </div>
  </div>
</section>
