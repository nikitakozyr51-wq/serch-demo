---
/**
 * «Как это устроено» — кадр Pencil `PdeQN`, 1440×1504.
 *
 * Слева колонка 282: заголовок и оглавление из четырёх пунктов; справа 894 —
 * четыре карточки шага. Оглавление в файле нарисовано со снятым первым
 * пунктом: у него номер и название графитовые и полужирные, у остальных —
 * приглушённые. Это состояние прокрутки, а не украшение, поэтому первый пункт
 * помечен `aria-current` — иначе выделение читается как «эта ссылка важнее».
 *
 * Оглавление ведёт к карточкам якорями: без этого выделенный пункт — просто
 * покрашенный текст, который никуда не ведёт.
 *
 * Фото 380×240 стоят справа от текста; ниже lg они уходят под текст во всю
 * ширину, сохраняя те же пропорции.
 *
 * НА ТЕЛЕФОНЕ ЭТОЙ СЕКЦИИ НЕТ ВОВСЕ. Мобильная главная (`EDoek`) идёт
 * первый экран → врез → возможности → районы → доказательства → тарифы →
 * вопросы → призыв → подвал: «Как это устроено» между врезом и возможностями
 * не нарисовано. Это не пропуск замера, а состав кадра: мобильные страницы
 * сайта — не адаптив десктопных, и четыре карточки с фотографиями 380×240
 * телефон не получает. Тот же довод на телефоне уже отработан врезом и
 * секцией склейки, а сам рассказ живёт отдельной страницей `/how-it-works`,
 * куда ведут и меню, и подвал, — поэтому ссылка ниже lg никуда не теряется.
 *
 * Скрыто вёрсткой, а не условием: разметка остаётся в документе для поисковых
 * роботов и для перехода на широкий экран без перезагрузки. Якорь
 * `#kak-eto-ustroeno` внутри секции никем снаружи не используется — меню и
 * подвал ведут на страницу, а не на этот блок, — поэтому мёртвых ссылок
 * скрытие не создаёт.
 */
import { stepPhotos } from '@/lib/site-photos'

const steps = [
  {
    id: 'shag-01',
    number: '01',
    label: 'ШАГ 01',
    title: 'Задайте параметры',
    text: 'Район, число комнат, цена. Счётчик найденного пересчитывается на каждом касании контрола, кнопки «Применить» не существует.',
    photo: stepPhotos[0],
  },
  {
    id: 'shag-02',
    number: '02',
    label: 'ШАГ 02',
    title: 'Получите объекты',
    text: 'Четыре площадки в одном списке. Дубли склеены в один объект, посредники отсеяны до того, как вы их увидели.',
    photo: stepPhotos[1],
  },
  {
    id: 'shag-03',
    number: '03',
    label: 'ШАГ 03',
    title: 'Откройте контакт',
    text: '199 ₽ за номер, и только когда агент решил звонить. Оказался посредник, отметьте возврат: деньги вернутся на баланс.',
    photo: stepPhotos[2],
  },
  {
    id: 'shag-04',
    number: '04',
    label: 'ШАГ 04',
    title: 'Звоните первыми',
    text: 'Видно, кто из ваших уже брал контакт, дозвонился ли и чем кончился разговор. Второй раз собственнику агентство не позвонит.',
    photo: stepPhotos[3],
  },
]
---

<section class="site-container hidden py-20 lg:block lg:py-35" id="kak-eto-ustroeno">
  <div class="flex flex-col gap-12 lg:flex-row lg:gap-6">
    {/* Заголовок и оглавление выходят с шагом 80, карточки — с 120: карточка
        крупнее строки, и на 80 четыре штуки читаются как одно движение. */}
    {/* Колонка липкая: заголовок и оглавление едут рядом с карточками, пока
        секция в кадре. Это не украшение — оглавление помечает первый шаг
        `aria-current`, и метка «где я» бессмысленна, если сам список уехал
        вверх ещё до второй карточки. `self-start` обязателен: в ряду flex
        колонка иначе растягивается на всю высоту, и липнуть ей нечем.
        80 = высота липкой шапки 64 + 16 воздуха. */}
    <div
      class="lg:sticky lg:top-20 lg:w-[282px] lg:shrink-0 lg:self-start"
      data-rev-group
    >
      <h2 class="text-26 font-semibold text-fg lg:text-40">Четыре шага от фильтра до первого звонка</h2>

      {/* Наведение красит обе части строки, а не саму ссылку: у номера и у
          названия свои цвета классами, и они перебивают наследование — до
          этого `hover:text-fg` на ссылке не давал вообще ничего. */}
      <nav class="mt-8 flex flex-col" aria-label="Шаги">
        {
          steps.map((step, index) => (
            <a
              class="ctl group flex h-12 items-center gap-4 border-t border-hairline"
              href={`#${step.id}`}
              aria-current={index === 0 ? 'true' : undefined}
            >
              <span
                class:list={[
                  'text-13 font-semibold transition-colors duration-150 group-hover:text-fg',
                  index === 0 ? 'text-fg' : 'text-text-dense',
                ]}
              >
                {step.number}
              </span>
              <span
                class:list={[
                  'text-17 transition-colors duration-150 group-hover:text-fg',
                  index === 0 ? 'font-semibold text-fg' : 'font-medium text-text-2',
                ]}
              >
                {step.title}
              </span>
            </a>
          ))
        }
      </nav>
    </div>

    <div class="flex flex-col gap-6 lg:w-[894px] lg:shrink-0" data-rev-group data-rev-step="120">
      {
        steps.map((step) => (
          <article
            class="hv-card flex flex-col gap-8 rounded-3xl bg-warm p-6 lg:h-72 lg:flex-row lg:items-center"
            id={step.id}
          >
            <div class="flex flex-col lg:flex-1">
              <span class="text-label-sm font-semibold text-text-dense">{step.label}</span>
              <h3 class="text-26 mt-3.5 font-semibold text-fg">{step.title}</h3>
              <p class="text-17-prose mt-3 font-medium text-text-2">{step.text}</p>
            </div>
            <img
              class="aspect-[380/240] w-full rounded-2xl object-cover lg:h-60 lg:w-[380px] lg:shrink-0"
              src={step.photo}
              alt=""
              width="380"
              height="240"
              loading="lazy"
              decoding="async"
            />
          </article>
        ))
      }
    </div>
  </div>
</section>
