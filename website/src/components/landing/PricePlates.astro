---
/**
 * Прайс, три плашки — компонент Pencil `xcGV2`, 1200×500.
 *
 * Ряд из трёх плашек по 384 через зазор 24. Плашка: поле 32, радиус 24, белая
 * заливка, обводка волосной линией; внутри «Верх» (зазор 16) прижат кверху,
 * «Низ» (зазор 10) — книзу, поэтому кнопки трёх плашек стоят на одной линии,
 * сколько бы ни было пунктов в списке.
 *
 * Третья плашка выделена обводкой 2 px ярким `accent-bright`, а её цена набрана
 * глубоким `accent-deep`: красный на сайте значит «здесь списываются деньги» и
 * больше ничего. Ранг плашки несёт обводка, а не размер: все три одной высоты.
 *
 * Плашка «Только за факт» — высота 24 и радиус 6, а не пилюля: пилюля означает
 * «нажми меня», а этот ярлык не нажимается.
 *
 * Строка доверия под кнопкой в файле набрана 14/500, но кегля 14 в лестнице
 * сайта нет. Взят соседний законный 13/500: строчный бокс у обоих один и тот же,
 * 20 px, поэтому геометрия плашки не сдвинулась ни на пиксель.
 *
 * Телефон — узел `m71UK` внутри «МОБАЙЛ · Главная» (`EDoek`): колонка через
 * 16, поле плашки 24, и один зазор 16 на всё содержимое плашки. Прижима книзу
 * на телефоне нет и быть не может: плашки стоят одна под другой, выравнивать
 * кнопки не с чем, поэтому высота 500 и `justify-between` живут только от lg.
 * Цена остаётся 40/600 со строкой, равной кеглю, — эта ступень на обеих
 * ширинах одна; расходится только зазор до единицы, 4 против 6.
 *
 * ДВА КАДРА ФАЙЛА СПОРЯТ, И СПОР НАЗВАН. На «МОБАЙЛ · Главная» плашки
 * перерисованы для телефона (`m71UK`, поле 24, высота по содержанию), а на
 * «МОБАЙЛ · Тарифы» (`gpcCa`) стоит нетронутый инстанс десктопного `xcGV2` —
 * с полем 32, фиксированной высотой 500 и прижимом книзу, просто вписанный в
 * ширину 358. Второе — не решение о телефоне, а компонент, положенный как
 * есть: у инстанса `OR1WY` переопределены только интерлиньяжи. Здесь взят
 * перерисованный вариант, потому что плашка в коде одна: два поля у одной и
 * той же карточки на двух страницах читались бы как ошибка вёрстки. От lg обе
 * страницы получают ровно десктопный замер.
 *
 * Строка доверия на телефоне у «Пробного старта» в файле обёрнута центрирующей
 * рамкой (`P4tVrY`), а у «Доступа агентства» лежит текстом по левому краю
 * (`ANml6`). Оставлено центрирование в обеих: на десктопе обе строки
 * центрированы одной и той же рамкой (`UXEkC`, `saAM5`), и разное выравнивание
 * одного и того же места на одной странице читается как недоделка, а не как
 * приём. Расхождение названо, а не спрятано.
 *
 * Зазор между плашками на телефоне тоже разошёлся: 16 на главной (`m71UK`) и
 * 12 на «Тарифах» (`OR1WY`). Взят 16 — по перерисованному кадру.
 *
 * Единица у доступа агентства в файле телефона сокращена до «/ мес». Здесь
 * оставлено «/ месяц»: сокращение экономит 30 px там, где их и так хватает,
 * а два разных написания одной единицы на одной странице читаются как ошибка.
 */
import { Check } from 'lucide-react'

import SiteButton from './SiteButton.astro'
import { signupHref } from '@/lib/site-routes'

interface Plate {
  /** Ярлык тарифа. */
  label: string
  /** Плашка рядом с ярлыком — только у «Раскрытого контакта». */
  badge?: string
  price: string
  /** Единицы у пробного старта нет: ноль ни за что не считается. */
  unit?: string
  description: string
  features: string[]
  action: { href: string; label: string; variant: 'primary' | 'secondary' | 'recommend' }
  /** Строка доверия под кнопкой; у третьей плашки её нет. */
  trust?: string
  /**
   * Рекомендованная плашка: волосяная обводка `accent` вместо `hairline`.
   *
   * Ровно одна на ряд. Две выделенные плашки — это ни одной выделенной.
   */
  accent?: boolean
}

const plates: Plate[] = [
  {
    label: 'Пробный старт',
    price: '0 ₽',
    description: 'Пять раскрытий при регистрации. Без карты.',
    features: ['Пять контактов включено', 'Вся выдача и все фильтры', 'Кабинет руководителя'],
    action: { href: signupHref, label: 'Начать бесплатно', variant: 'primary' },
    trust: 'Без карты',
  },
  {
    label: 'Доступ агентства',
    price: '3 000 ₽',
    unit: '/ месяц',
    description: 'За агентство целиком, а не за сотрудника. До двадцати человек.',
    features: [
      'Безлимитный поиск и фильтры',
      'Воронка агентства в рублях',
      'Журнал доступа, стоп-лист, возвраты',
    ],
    action: { href: 'mailto:hello@serch.ru', label: 'Спросить о договоре', variant: 'recommend' },
    trust: 'Работаем с юридическими лицами',
    accent: true,
  },
  {
    label: 'Раскрытый контакт',
    badge: 'Только за факт',
    price: '199 ₽',
    unit: '/ контакт',
    description: 'Списывается, когда агент решил звонить. Нераскрытые объекты не стоят ничего.',
    features: [
      'Прямой номер собственника',
      'Паспорт данных: откуда взят номер',
      'Вернём, если это посредник',
      'Один счёт в конце месяца',
    ],
    action: { href: signupHref, label: 'Создать агентство', variant: 'primary' },
  },
]
---

{/* Плашки — карточки, поэтому шаг 120, а не 80. Атрибут стоит на самом
    компоненте: ряд одинаково собран и на главной, и на «Тарифах», и второй
    экземпляр правила завёлся бы врозь с первым. */}
<div class="flex w-full flex-col gap-4 lg:flex-row lg:gap-6" data-rev-group data-rev-step="120">
  {
    plates.map((plate) => (
      <article
        class:list={[
          'hv-card flex flex-1 flex-col justify-between gap-4 rounded-3xl bg-surface p-6 lg:h-125 lg:gap-0 lg:p-8',
          /*
            Обводка волосяная и у выделенной плашки тоже — 1 px `accent`,
            а не 2 px. Замер `xcGV2/v2Nfb` от 10.08.2026: толщина у всех
            трёх одна, различается только цвет. Двойная толщина сдвигала
            содержимое выделенной плашки на пиксель внутрь, и три ряда
            фактов переставали стоять на одной линии.

            Выделена вторая плашка, «Доступ агентства», а не третья: это
            рекомендованная покупка. Третья, «Раскрытый контакт», — цена
            за факт, её не выбирают, она наступает сама.
          */
          plate.accent ? 'border border-accent-bright' : 'border border-hairline',
        ]}
      >
        <div class="flex flex-col gap-4">
          <div class="flex items-center justify-between">
            <h3 class="text-15 font-semibold text-text-2">{plate.label}</h3>
            {plate.badge && (
              <span class="rounded-sm bg-fg px-3 py-1 text-12 font-semibold text-surface">
                {plate.badge}
              </span>
            )}
          </div>

          {/* Цена и единица: 4 на телефоне (`fIaQn`, `zcRFB`, `JyFmU`) и 6 от
              lg (`p4WnR`, `hlqdm`, `sWGd4`). Обе меры из файла. */}
          <div class="flex items-end gap-1 lg:gap-1.5">
            {/* Цена графитом у всех трёх. Красная цена на «199 ₽» была
                дорисована, а не снята: в файле все три числа `#1e1e1e`.
                Красный на сайте закреплён за кнопкой рекомендованного
                тарифа, и второе красное рядом отменяло бы первое. */}
            <span class="text-num-40 font-semibold text-fg">{plate.price}</span>
            {plate.unit && <span class="text-15 font-medium text-text-2">{plate.unit}</span>}
          </div>

          <p class="text-15 font-medium text-text-2">{plate.description}</p>

          <ul class="flex flex-col gap-3 lg:pt-1.5">
            {plate.features.map((feature) => (
              <li class="flex items-center gap-2 text-15 font-medium text-fg">
                <Check className="size-4 shrink-0" aria-hidden="true" />
                {feature}
              </li>
            ))}
          </ul>
        </div>

        <div class="flex flex-col gap-4 lg:gap-2.5">
          <SiteButton
            href={plate.action.href}
            label={plate.action.label}
            variant={plate.action.variant}
            width="full"
          />
          {plate.trust && (
            <p class="text-13 text-center font-medium text-text-2">{plate.trust}</p>
          )}
        </div>
      </article>
    ))
  }
</div>
