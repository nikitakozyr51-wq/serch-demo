---
/**
 * Строка юридического контура — `riqcq`, `yS60H`, `G0avy2` на «Законе».
 *
 * Три колонки через 24: заголовок 282 (20/600 с тесной строкой 1.2), текст 486
 * (15/500) и артефакт 384. Поля 32 сверху и снизу, верхняя волосная линия;
 * у последней строки линия есть и снизу — иначе блок обрывается в воздух.
 *
 * Артефакт — это не картинка, а кусок настоящего интерфейса кабинета, поэтому
 * он приходит содержимым: у каждой строки он свой, а на «О компании» и
 * «Контактах» той же строки артефакта нет вовсе.
 *
 * Ниже 1024 колонки встают друг под друга: 282 + 486 + 384 не помещаются даже
 * на планшете.
 *
 * Телефон — «Механизмы» в кадре `RbWlq` и «Список разделов» на «Оферте»
 * (`j1bD09`): контур перестаёт быть таблицей и становится строкой
 * «ключ — значение» — компонентом файла `t0Up5P`. Ступень целиком вынесена
 * в класс `.key-row` в `global.css`, потому что тем же примитивом на телефоне
 * набраны и вопросы (`SiteFaq`), и держать одни и те же 14 · 4 · 13/600 ·
 * 13/500 в двух компонентах значит однажды поправить их в одном.
 *
 * Линия ниже lg — `line-2` (#ddd9d3) из `.key-row`, а от lg — `hairline`
 * (#e7e5e0) по замеру `riqcq`. Раньше здесь на обеих ширинах стоял `hairline`:
 * замер телефона не был снят, и десктопное значение было принято за общее.
 */
interface Props {
  title: string
  text: string
  /** Последняя строка блока получает ещё и нижнюю линию. */
  last?: boolean
  /**
   * Заголовок-ссылка. На «Контактах» заголовками строк служат почтовые
   * адреса: в Pencil они простой текст, но адрес, по которому нельзя написать
   * нажатием, — дефект страницы, единственная работа которой это связь.
   * Оформление не меняется: `mailto:` не виден и ничего не сдвигает.
   */
  titleHref?: string
}

const { last = false, text, title, titleHref } = Astro.props
---

<div
  class:list={[
    'key-row key-row-stack lg:flex-row lg:gap-6 lg:border-hairline lg:py-8',
    // Нижняя линия только от lg: на телефоне список кончается последней
    // строкой без обводки (замер `lWMdp`, `ZksI7`, `Wr6UP` — у всех задана
    // одна верхняя линия).
    last ? 'lg:border-b' : '',
  ]}
>
  <h3 class="key-row-term lg:text-20-tight lg:w-[282px] lg:shrink-0">
    {/* Заголовок-адрес уже стоит на `fg`, поэтому у него ступени графита:
        наведение `fg-hover`, нажатие `fg-press` — ровно те же, что у кнопки.
        Оба шага приходят из общего набора `.ctl-ink` в `global.css`. */}
    {
      titleHref ? (
        <a class="ctl ctl-ink transition-colors duration-150" href={titleHref}>
          {title}
        </a>
      ) : (
        title
      )
    }
  </h3>
  <p class="key-row-value lg:text-15 lg:w-[486px] lg:shrink-0">{text}</p>
  {/* Артефакт живёт только от lg. На телефоне строка контура — это ровно два
      текста: во всех 51 экземпляре `t0Up5P` по кадрам сайта у узла два
      ребёнка, и оба текстовые. Куска кабинета там нет ни разу. Строка на 390
      выходит 92–132 px вместо 200 с лишним, то есть контур из шести строк
      перестаёт быть экраном с картинками и становится списком. */}
  <div class="empty:hidden max-lg:hidden lg:w-96 lg:shrink-0">
    <slot />
  </div>
</div>
