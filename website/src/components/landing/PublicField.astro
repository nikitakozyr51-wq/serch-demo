---
/**
 * Поле публичной служебной страницы — `kkpoL`/`wZaYE` на «Удалить мои данные»
 * и `Uefvd` на «Подтвердите, что номер ваш».
 *
 * Колонка 520: метка 11/600 с трекингом +0.66, зазор 8, поле высотой 48 с
 * радиусом 12 — пара «высота — радиус» из карты, 44 и 48 идут с 12. Заливка
 * белая (`surface`), а не фон страницы: поле обязано читаться как то, во что
 * пишут. Граница `border-control` — единственная граница на сайте, у которой
 * есть контраст к фону: волосная линия под ввод не годится.
 *
 * Метка набрана прописными прямо в тексте, а не `text-transform`, потому что
 * так она набрана в файле и так её прочитает экранный диктор.
 *
 * Значение в файле нарисовано заполненным («+7 900 000-23-72»), но страница
 * открывается по ссылке из письма с пустыми полями, поэтому здесь это
 * подсказка, а не значение. Цвет подсказки взят с того единственного узла
 * файла, который заведомо пустой: почта на телефонном кадре `fiurK` набрана
 * `text-dense`, тогда как заполненный телефон — `fg`.
 *
 * ПЛОТНЫЙ ВАРИАНТ (`dense`) — поля на `serch.ru/stop`, кадр `H83QZ`. Там на
 * широком экране поле не 48, а 40: высота 40 → радиус 10, поле 12, значение
 * 14/500. Обе пары «высота — радиус» законны, ступень не выдумана. На телефоне
 * (кадр `V9ILWs`) то же поле снова 48 с радиусом 12 — то есть плотность здесь
 * появляется на широком экране, а не на узком. Порядок обратный привычному,
 * но обе меры сняты: на 1440 форма стоит в колонке рядом с панелью и обязана
 * быть тише её, на телефоне в неё целятся пальцем.
 */
interface Props {
  /** Связывает метку с полем. */
  id: string
  label: string
  name: string
  placeholder: string
  type: 'tel' | 'email' | 'text'
  /** Клавиатура телефона: цифровая у кода из SMS. */
  inputmode?: 'numeric' | 'tel' | 'email'
  autocomplete?: string
  /**
   * Строка под полем: что именно сюда вводить. Связана с полем через
   * `aria-describedby`, иначе диктор прочитает метку и замолчит.
   */
  hint?: string
  /** Поле 40 вместо 48 на широком экране — форма `serch.ru/stop`. */
  dense?: boolean
}

const { autocomplete, dense = false, hint, id, inputmode, label, name, placeholder, type } =
  Astro.props

const hintId = `${id}-hint`

// Состояния поля сняты с доски `СИСТЕМА · Состояния контролов`, строка
// «Поле 40» (`aVkKz`): покой — белая заливка с границей `border-control`,
// наведение — та же заливка, граница на ступень темнее (`text-2`), фокус —
// кольцо 2 px `fg` снаружи вместо границы. Нажатие у поля отдельным
// состоянием не нарисовано, и это защитимо: нажатие в поле и есть фокус.
const inputClasses = [
  'ctl ctl-field',
  'h-ctl-lg w-full rounded-xl border px-3.5 text-16 font-medium text-fg placeholder:text-text-dense',
  'transition-colors duration-150',
  dense ? 'lg:h-ctl-md lg:rounded-lg lg:px-3 lg:text-14' : 'lg:px-4',
]
---

<div class="flex max-w-[520px] flex-col gap-2">
  <label class="text-label-sm font-semibold text-text-dense" for={id}>{label}</label>
  <input
    class:list={inputClasses}
    aria-describedby={hint ? hintId : undefined}
    autocomplete={autocomplete}
    id={id}
    inputmode={inputmode}
    name={name}
    placeholder={placeholder}
    type={type}
  />
  {
    hint && (
      <p class="text-13 font-medium text-text-dense lg:text-12" id={hintId}>
        {hint}
      </p>
    )
  }
</div>
