---
/**
 * Блок «Вопросы» — `Z7v3Y7` на «Тарифах» и `emHVB` на «Законе и данных».
 *
 * Слева колонка 384 с заголовком 40/600 и лидом, справа список 792. Строка:
 * поля по 24 сверху и снизу, верхняя волосная линия, у последней строки — ещё
 * и нижняя. Вопрос 17/600, значок 20, абзац 15/500 через 14.
 *
 * Первая строка живёт в двух видах, и оба сняты замером. На «Законе» у неё
 * такая же верхняя линия, как у остальных. На «Тарифах» линии нет (в файле у
 * узла `mb50A` обводка задана, а толщина — нет, поэтому линия не рисуется), и
 * вместо неё список опущен на 14: без линии первый вопрос иначе встаёт выше
 * заголовка слева.
 *
 * Значок в файле — состояние, а не картинка: `minus` у раскрытых строк,
 * `plus` у свёрнутых. Поэтому здесь собран настоящий `details`, и значок
 * следует за состоянием, а не прибит к разметке.
 *
 * СВЁРНУТО В МАКЕТЕ — ЭТО СОСТОЯНИЕ, А НЕ ОТСУТСТВИЕ ТЕКСТА. Здесь была
 * ошибка чтения файла, и владелец увидел её сразу: «вопросы на главной сделаны
 * не аккордеоном и не нажимаются». Свёрнутая строка со значком `plus`
 * означает «ответ есть, он закрыт», а не «ответа нет». Раньше такие строки
 * рисовались обычным `div` — со значком `plus`, но без раскрывашки, — то есть
 * обещали нажатие и не давали его.
 *
 * Теперь правило простое: есть ответ — строка раскрывается; ответа нет —
 * строка рисуется БЕЗ ЗНАЧКА, и ничего не обещает. Значок и раскрывашка
 * появляются и исчезают вместе, поэтому дефект «выглядит нажимаемым, но не
 * нажимается» больше не собирается в принципе.
 *
 * `open` — начальное состояние строки, снятое с файла: на главной раскрыты
 * первые два вопроса, остальные свёрнуты. Раньше `open` стоял на всех строках
 * с текстом разом, и список открывался целиком.
 *
 * Телефон — узел `fEDoa` внутри «МОБАЙЛ · Главная» (`EDoek`): поля секции 80
 * вместо 120–140, колонка вместо ряда через 24, заголовок 26/600 вместо
 * 40/600, лид 17/500 с интерлиньяжем 1.4118 вместо прозаического 1.6471.
 * Строка: поля 20 сверху и снизу вместо 24, зазор «вопрос — значок» 16 вместо
 * 20, зазор «вопрос — ответ» 12. Кегль вопроса на телефоне 17 везде, включая
 * главную, где на десктопе он 20.
 *
 * НО ЭТО ТОЛЬКО ГЛАВНАЯ. На остальных страницах телефон вообще не показывает
 * раскрывашку: файл перебирает вопросы в строку «ключ — значение» `t0Up5P` —
 * ту же, которой набраны механизмы «Закона» и разделы «Оферты». Замер
 * `eBcMt` («Тарифы») и `RAihb` («Закон») даёт поля 14 вместо 20, зазор
 * «вопрос — ответ» 4 вместо 12, вопрос 13/600 вместо 17/600, ответ 13/500
 * вместо 15/500, линию `line-2` вместо `hairline` и НИ ОДНОГО значка. Это
 * свойство `dense`, а не автоматика: главная и внутренние страницы — два
 * прописанных вида, а не один с порогом.
 *
 * Секция в плотном виде своих полей не имеет: тело мобильной страницы — одна
 * колонка с зазором 24, и 12 сверху и снизу складываются с соседями ровно в
 * него. Тот же приём уже стоит в `LegalSection`.
 *
 * Раскрывашка при этом остаётся: значок скрыт вёрсткой, а не убран из
 * разметки, поэтому свёрнутый на телефоне ответ по-прежнему разворачивается
 * нажатием и по-прежнему один и тот же узел DOM читается диктором один раз.
 */
import { Minus, Plus } from 'lucide-react'

export interface FaqItem {
  question: string
  /**
   * Текст ответа. Нет текста — строка не раскрывается И НЕ ПОКАЗЫВАЕТ ЗНАЧОК:
   * обещание нажатия и само нажатие живут вместе.
   */
  answer?: string
  /** Раскрыта при загрузке. Снято с файла; по умолчанию строка свёрнута. */
  open?: boolean
}

interface Props {
  title: string
  lead: string
  items: FaqItem[]
  /** Верхняя линия у первой строки: есть на «Законе», нет на «Тарифах». */
  firstRule?: boolean
  /**
   * Кегль вопроса. На главной он 20, на всех остальных страницах 17 — это
   * единственное расхождение лестницы FAQ во всём файле, и оно намеренное:
   * на главной блок стоит сам по себе, на служебных страницах — среди текста.
   */
  question?: 20 | 17
  /** Верхнее поле секции: 140 на главной, 120 на «Тарифах» и «Законе». */
  top?: 140 | 120
  /** Зазор вопрос — ответ у первой строки: 16 на главной, 14 дальше. */
  firstGap?: 16 | 14
  /**
   * Плотный вид на телефоне — строка «ключ — значение» вместо раскрывашки.
   * Стоит на всех страницах, кроме главной: так в файле.
   */
  dense?: boolean
}

const {
  dense = false,
  firstGap = 14,
  firstRule = true,
  items,
  lead,
  question = 17,
  title,
  top = 120,
} = Astro.props

// Класс строки считается один раз здесь, чтобы разметка ниже читалась как
// содержание, а не как ветвление.
//
// Плотный вид берёт рамку у `.key-row` (14 и линия `line-2`, у первой строки
// линии нет) и возвращает десктопную ступень от lg. Обычный вид не изменился.
const rowClass = (index: number) => {
  const first = index === 0 && !firstRule
  const last = index === items.length - 1

  if (dense) {
    return [
      'key-row lg:border-hairline',
      first ? 'lg:border-t-0 lg:pt-0 lg:pb-6' : 'lg:py-6',
      last ? 'lg:border-b' : '',
    ]
  }

  // Отсутствие первой линии и наличие последней — свойства ШИРОКОГО экрана.
  // Замер мобильной главной (`fEDoa`) даёт ровно обратное: у первой строки
  // `tQFhq` линия есть и поля симметричные 20/20, у последней `R4IqS` нижней
  // линии нет. То же правило, что на внутренних страницах: на телефоне линия
  // разделяет строки, а не обводит список. Раньше `firstRule` и `last`
  // работали на обеих ширинах, и мобильная главная теряла первую линию и
  // получала лишнюю последнюю.
  return [
    'border-hairline border-t py-5',
    first ? 'lg:border-t-0 lg:pt-0 lg:pb-6' : 'lg:py-6',
    last ? 'lg:border-b' : '',
  ]
}

// Кегль 20 живёт только от lg: на телефоне вопрос набран 17 на главной и 13
// на остальных страницах.
const questionClass = [
  'flex-1 font-semibold text-fg',
  dense ? 'text-13 lg:text-17' : 'text-17',
  question === 20 ? 'lg:text-20' : '',
].join(' ')
const iconClass = 'size-5 shrink-0 text-fg'
// Значка в плотном виде на телефоне нет: в `t0Up5P` два текста и больше
// ничего. Скрыт вёрсткой, а не убран, — раскрывашка обязана остаться рабочей.
const iconWrapClass = dense ? 'inline-flex shrink-0 max-lg:hidden' : 'inline-flex shrink-0'

// Наведение и нажатие у раскрывашки. Группа названа (`row`), а не общая: без
// имени `group-hover` сработал бы и от курсора над ответом — строка отвечала
// бы на наведение туда, куда нажать нельзя.
//
// Ступень взята та же, что у графитовой кнопки и у заголовков-ссылок:
// `fg` → `fg-hover` → `fg-press`. Заливки у строки нет и быть не должно —
// она стоит на фоне страницы между двумя волосными линиями, и третья
// поверхность ради состояния на долю секунды здесь была бы перегрузом.
const rowInk = 'transition-colors duration-150 group-hover/row:text-fg-hover'
const rowInkPressed = `${rowInk} group-active/row:text-fg-press`
---

<section
  class:list={[
    // 12 сверху и снизу в плотном виде: тело мобильной страницы — колонка
    // с зазором 24, и поля секции складываются с соседями ровно в него.
    dense ? 'py-3' : 'py-20',
    top === 140 ? 'lg:pt-35' : 'lg:pt-30',
    'lg:pb-35',
  ]}
>
  <div class="site-container flex flex-col gap-6 lg:flex-row">
    {/* Заголовок и список — две группы по 80. Раскрывашка внутри строки не
        трогается: `data-rev` снимается по `transitionend`, и открытый `details`
        живёт своей жизнью. */}
    <div
      class:list={[
        'flex flex-col lg:w-96 lg:shrink-0 lg:gap-5',
        // Шапка блока на внутренних страницах тише: 20/600 и 15/500 через 8
        // (замер `H8NaDu` и `Q8047E`) против 26/600 и 17/500 через 14 на
        // главной. Это два прописанных вида, а не один уменьшенный.
        dense ? 'gap-2' : 'gap-3.5',
      ]}
      data-rev-group
    >
      <h2 class:list={['font-semibold text-fg lg:text-40', dense ? 'text-20' : 'text-26']}>
        {title}
      </h2>
      <p
        class:list={[
          'font-medium text-text-2 lg:text-17-prose',
          dense ? 'text-15' : 'text-17',
        ]}
      >
        {lead}
      </p>
    </div>

    <div
      class:list={['flex flex-col lg:w-[792px]', firstRule ? '' : 'lg:pt-3.5']}
      data-rev-group
    >
      {
        items.map((item, index) =>
          item.answer ? (
            <details class:list={['group', ...rowClass(index)]} open={item.open}>
              <summary class="ctl group/row flex cursor-pointer list-none items-center gap-4 lg:gap-5 [&::-webkit-details-marker]:hidden">
                <h3 class={`${questionClass} ${rowInkPressed}`}>{item.question}</h3>
                {/* Значки скрыты обёрткой, а не собственным классом: у
                    `Minus` уже стоит пара `hidden`/`group-open:block`, и
                    третье правило display на том же узле зависело бы от
                    порядка вариантов в собранном CSS. Обёртка снимает
                    вопрос порядка целиком. */}
                <span class:list={[iconWrapClass]}>
                  <Plus
                    className={`${iconClass} ${rowInk} group-open:hidden`}
                    aria-hidden="true"
                  />
                  <Minus
                    className={`${iconClass} ${rowInk} hidden group-open:block`}
                    aria-hidden="true"
                  />
                </span>
              </summary>
              {/* `details` не отдаёт `gap` детям надёжно во всех браузерах,
                  поэтому зазор стоит отступом на самом абзаце. */}
              <p
                class:list={[
                  'font-medium text-text-2 lg:text-15',
                  dense ? 'text-13 mt-1' : 'text-15 mt-3',
                  index === 0 && firstGap === 16 ? 'lg:mt-4' : 'lg:mt-3.5',
                ]}
              >
                {item.answer}
              </p>
            </details>
          ) : (
            /* Ответа нет — значка тоже нет. Со значком строка выглядела бы
               раскрывашкой и молчала на нажатие; это ровно тот дефект, на
               который жалуется владелец. */
            <div class:list={rowClass(index)}>
              <div class="flex items-center gap-4 lg:gap-5">
                <h3 class={questionClass}>{item.question}</h3>
              </div>
            </div>
          )
        )
      }
    </div>
  </div>
</section>
