---
/**
 * «Доказательства» — кадр Pencil `Dj0Hn`, 1440×716, залит `warm`.
 *
 * Слева 486 — довод и алерт, справа 690 — воронка агентства за 30 дней и
 * итог в рублях. Смысл блока в том, что руководитель видит деньги, поэтому
 * первая полоса воронки залита `fg`, а остальные — `text-2`: потраченные
 * рубли выделены среди штук.
 *
 * Заливки полос в файле заданы в пикселях по дорожке 350 (320 · 320 · 172 ·
 * 31 · 6). Здесь они переведены в доли той же дорожки: дорожка тянется по
 * ширине колонки, и пропорция между строками обязана пережить любую ширину —
 * иначе «3 договора» на узком экране окажутся шире, чем «17 встреч».
 *
 * Подложка дорожки — 8 % чёрного, а не серый из палитры: блок стоит на `warm`,
 * а такой же индикатор встречается и на `bg`, и прозрачная подложка ложится
 * на обе поверхности одинаково.
 *
 * Телефон — кадр `D36I3Y` внутри «МОБАЙЛ · Главная» (`EDoek`). Колонка одна,
 * и весь блок держит единственный зазор 32: заголовок → лид → алерт →
 * воронка. Поэтому на телефоне между заголовком и лидом 32, а не 16, и между
 * алертом и воронкой 32, а не 48. Остальные меры телефона: поле алерта 16 со
 * всех сторон вместо 16/20, метка воронки отбита на 12 вместо 16, строка
 * воронки набрана полями 14 вместо высоты 56, зазор «строка — дорожка» 10.
 *
 * Итог на телефоне — не ряд из двух чисел с вертикальной чертой, а колонка
 * через 16, где черта горизонтальная и во всю ширину (`bnNCZ`). Поле у него
 * только сверху 20: снизу и по бокам итог не отступает, потому что стоит
 * последним в секции. На широком экране это по-прежнему ряд с полем 24.
 */
import { TriangleAlert } from 'lucide-react'

const track = 350

const funnel = [
  { name: 'Потрачено на контакты', fill: 320, value: '35 422 ₽', money: true },
  { name: 'Раскрыто контактов', fill: 320, value: '178' },
  { name: 'Дозвонились', fill: 172, value: '96' },
  { name: 'Встреч', fill: 31, value: '17' },
  { name: 'Договоров', fill: 6, value: '3' },
]
---

<section class="bg-warm py-20 lg:py-35">
  <div class="site-container flex flex-col gap-8 lg:flex-row lg:items-center lg:gap-6">
    {/* Довод и воронка выходят двумя группами по 80: на широком экране они
        стоят рядом, и общая очередь заставила бы правую колонку ждать левую.
        Воронка выходит целиком, полосами её не разбирают: сравнивать нечего,
        пока приехала половина строк. */}
    <div class="lg:w-[486px] lg:shrink-0" data-rev-group>
      <h2 class="text-26 font-semibold text-fg lg:text-40">
        Руководитель видит рубли, а не активность
      </h2>
      <p class="text-17-prose mt-8 font-medium text-text-2 lg:mt-4">
        В подписке стоимость контакта не существует как величина. Здесь у каждой встречи есть цена,
        и видно, чьи контакты становятся договорами.
      </p>

      <div
        class="mt-8 flex items-center gap-3 rounded-2xl border border-hairline bg-surface p-4 lg:px-5 lg:py-4"
      >
        <TriangleAlert className="size-5 shrink-0 text-fg" aria-hidden="true" />
        <div class="flex flex-col gap-1">
          <span class="text-15 font-semibold text-fg">
            12 контактов раскрыто и не прозвонено дольше 48 часов
          </span>
          <span class="text-13 font-medium text-text-2">
            2 388 ₽ лежат без движения. Видно, у кого именно.
          </span>
        </div>
      </div>
    </div>

    <div class="lg:w-[690px] lg:shrink-0" data-rev-group>
      <p class="text-label font-semibold text-text-dense">ВОРОНКА АГЕНТСТВА ЗА 30 ДНЕЙ</p>

      <div class="mt-3 flex flex-col lg:mt-4">
        {
          funnel.map((row) => (
            /* Ниже lg колонка названий 190 не помещается, а если ей дать сжаться,
               полосы начнутся с разного места и сравнивать их станет нечем.
               Поэтому на узком экране название и значение встают в одну строку,
               а дорожка уходит под них во всю ширину: начало у всех пяти полос
               снова общее. Порядок в разметке — смысловой, местами их меняет
               `order`, чтобы на широком экране дорожка стояла посередине. */
            <div class="flex flex-wrap items-center gap-x-5 gap-y-2.5 border-t border-hairline py-3.5 lg:h-14 lg:flex-nowrap lg:py-0">
              <span class="text-15 order-1 font-medium text-text-2 lg:w-[190px] lg:shrink-0">
                {row.name}
              </span>
              <span class="order-3 h-2 w-full min-w-0 rounded-full bg-track-neutral lg:order-2 lg:flex-1">
                <span
                  class:list={['block h-2 rounded-full', row.money ? 'bg-fg' : 'bg-text-2']}
                  style={`width: ${((row.fill / track) * 100).toFixed(2)}%`}
                />
              </span>
              <span class="text-17 order-2 ml-auto text-right font-semibold text-fg lg:order-3 lg:ml-0 lg:w-[110px] lg:shrink-0">
                {row.value}
              </span>
            </div>
          ))
        }
      </div>

      {/* Поля разведены по сторонам, а не собраны в `p-6`: на телефоне итог
          отступает только сверху, и шорткат затирал бы это правило порядком
          вариантов в собранном CSS, а не замером. */}
      <div
        class="mt-5 flex flex-col gap-4 border-t border-line-3 pt-5 lg:mt-6 lg:flex-row lg:flex-wrap lg:items-center lg:gap-8 lg:px-6 lg:pt-6 lg:pb-6"
      >
        <div class="flex flex-col gap-1">
          <span class="text-num-26 font-semibold text-fg">2 084 ₽</span>
          <span class="text-13 font-medium text-text-2">стоимость одной встречи</span>
        </div>
        {/* Одна и та же черта: на телефоне горизонтальная во всю ширину
            (`bnNCZ`, 350×1), от lg — вертикальная 1×44 (`fXqVy`). */}
        <span class="h-px w-full bg-line-3 lg:h-11 lg:w-px" aria-hidden="true"></span>
        <div class="flex flex-col gap-1 lg:gap-1.5">
          <span class="text-num-26 font-semibold text-fg">11 807 ₽</span>
          <span class="text-13 font-medium text-text-2">стоимость одного договора</span>
        </div>
      </div>
    </div>
  </div>
</section>
