---
/**
 * Шапка публичной служебной страницы — `nTJVE` на «Удалить мои данные»,
 * `opGhy` на «Данные удалены», `t0SaGs` на «Подтвердите, что номер ваш».
 * Все три узла в файле совпадают до пикселя, различается только подпись.
 *
 * Это ВТОРАЯ шапка сайта, и она не вариант первой. Шапка сайта `zB5U7` —
 * полоса 64 на `bg` с навигацией и призывом «Создать агентство». Здесь полоса
 * 72 на белом с границей `line-2`, без единой ссылки и без призыва. Разница
 * в назначении: сюда собственник попадает по ссылке из SMS или письма, он нам
 * не клиент, и предлагать ему завести агентство — грубость. Поэтому шапка
 * отвечает только на два вопроса: куда я попал и кто вы такие.
 *
 * Поля 48, а не контейнер 1200: полоса тянется во всю ширину кадра, замер
 * `nTJVE` даёт логотип на x=48 и правый край строки оператора на 1392.
 *
 * Телефон — это уже не эта полоса, а общая мобильная полоса 56 всего сайта
 * (`SiteMobileBar`, компонент файла `zpsSi`). Проверено замером: полоса на
 * кадрах `fiurK`, `y3kwGl`, `WiXGt`, `V9ILWs` и `IYGll` совпадает с `zpsSi`
 * до пикселя — те же 56, те же поля 16, тот же зазор 12, та же заливка и та
 * же линия `line-2`. Раньше эти же меры были набраны здесь второй раз, и
 * копия успела разойтись с оригиналом на 2 px: марка собиралась с зазором 8
 * вместо шести. Полоса теперь одна на весь сайт.
 *
 * Строка оператора на телефоне исчезает — на 390 она заняла бы три строки и
 * вытеснила бы саму подпись. Подписи для двух ширин в файле разные по тексту,
 * поэтому это два прописанных значения, а не одно обрезанное:
 * «serch.ru/data · удаление данных» против «serch.ru/data · удаление».
 */
import BrandMark from './BrandMark.astro'
import SiteMobileBar from './SiteMobileBar.astro'
import { siteRoutes } from '@/lib/site-routes'

interface Props {
  /** Подпись рядом с маркой на широком экране. */
  caption: string
  /** Своя, более короткая подпись для телефона. */
  captionSm: string
}

const { caption, captionSm } = Astro.props
---

{/* Две полосы, а не одна с переключением: на 1440 это шапка 72 с разделителем
    и строкой оператора, на 390 — общая полоса 56 сайта. Ниже lg показана
    ровно одна из них, поэтому двух ориентиров `banner` на экране не бывает. */}
<div class="lg:hidden">
  <SiteMobileBar caption={captionSm} />
</div>

<header class="hidden border-b border-line-2 bg-surface lg:block">
  <div class="flex h-18 items-center gap-4 px-12">
    <a class="ctl rounded-sm" href={siteRoutes.home} aria-label="Сёрчь, на главную">
      <BrandMark dot={6} />
    </a>

    <span class="h-5 w-px shrink-0 bg-line-2" aria-hidden="true"></span>
    <span class="text-13 font-medium text-text-dense">{caption}</span>

    <span class="flex-1"></span>

    <span class="text-12 font-medium text-text-dense">
      оператор персональных данных, уведомление в Роскомнадзор № 78-19-004182
    </span>
  </div>
</header>
