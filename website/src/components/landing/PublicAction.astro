---
/**
 * Главное действие публичной служебной страницы — инстансы компонента
 * `EDAmG` («C Кнопка · 48») в кадрах `C2Fnim`, `z0bYqe`, `LMsWf`.
 *
 * Почему это не `SiteButton`. Лестница контролов лендинга закрыта двумя
 * ступенями — 48/17 и 28/13, — и третьей в ней быть не должно. Служебные
 * страницы в файле набраны кабинетной лестницей: высота 48, поле 24, метка
 * 16/600 с трекингом −0.24. Ступень настоящая, но чужая, поэтому она живёт
 * отдельным компонентом, а не переопределением у кнопки лендинга: иначе
 * лестница лендинга перестала бы быть закрытой ради трёх страниц.
 *
 * Радиус — пилюля, и это по правилу, а не по высоте: пилюлю получает только
 * главное действие. На каждой из трёх страниц действие ровно одно.
 *
 * Пять состояний приходят одним набором из `global.css` (`.ctl-solid`,
 * `ctl-dark`) — тем же, что у кнопки лендинга. Дублировать ступени заливки
 * здесь нельзя: это второй экземпляр той же лестницы, и он разъехался бы.
 */
interface Props {
  href?: string
  label: string
  /** Кнопка внутри формы отправляет её; ссылка ведёт на другую страницу. */
  type?: 'button' | 'submit'
}

const { href, label, type = 'button' } = Astro.props

const classes = [
  'ctl ctl-solid ctl-dark',
  'inline-flex h-ctl-lg items-center justify-center rounded-full px-6',
  'text-16 font-semibold',
  'transition-colors duration-150',
]
---

{
  href ? (
    <a class:list={classes} href={href}>
      {label}
    </a>
  ) : (
    <button class:list={classes} type={type}>
      {label}
    </button>
  )
}
