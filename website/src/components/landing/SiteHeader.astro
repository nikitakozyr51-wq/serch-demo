---
/**
 * Шапка сайта — компонент Pencil `zB5U7`, 1440×64, и мобильный кадр `AcWMe`
 * внутри «МОБАЙЛ · Главная» (`EDoek`), 390×56.
 *
 * ГЛАВНОЕ. Ниже lg эта шапка живёт ТОЛЬКО на главной. Мобильные кадры сайта —
 * не адаптив десктопных: на 23 из 24 кадров шириной 390 вместо шапки с
 * навигацией стоит полоса 56 с маркой и подписью раздела (`SiteMobileBar`,
 * компонент файла `zpsSi`), и ни ссылок, ни призыва, ни меню там нет вовсе.
 * Исключение одно — «МОБАЙЛ · Главная» (`AcWMe`): там полоса 56 с призывом и
 * кнопкой меню, то есть настоящая шапка. Поэтому оболочка выбирается по
 * адресу: главная получает шапку на любой ширине, остальные страницы — полосу
 * ниже lg и шапку от lg. Это правило файла, а не удобство вёрстки.
 *
 * Десктоп: полоса 64 на фоне `bg`, снизу волосная линия 1 px, внутри ряд 1200:
 * вордмарк слева, две ссылки через зазор 28 и кнопка-призыв справа.
 *
 * Телефон (замер `AcWMe`, только главная): полоса 56, поле по горизонтали 20,
 * заливка `#F9F9F9B8` — тот же `bg`, но при 72 %. Ссылок в ряду нет, вместо
 * них справа от призыва стоит кнопка 44×44 со значком `menu` через зазор 10.
 * Точка вордмарка на телефоне 7×7, на десктопе 8×8 — обе меры из файла.
 *
 * Полупрозрачность имеет смысл только над прокруткой: над непрозрачным фоном
 * страницы 72 % от `#f9f9f9` дают тот же `#f9f9f9`. Поэтому полоса липкая —
 * иначе замер заливки нечего показывать.
 *
 * ЛИПКАЯ НА ЛЮБОЙ ШИРИНЕ — решение владельца против файла, и оно названо
 * вслух. В Pencil десктопная шапка нарисована в потоке страницы, и раньше
 * здесь стояло `lg:static`: на широком экране шапка уезжала вверх вместе со
 * страницей. Владелец считает это дефектом («header теперь пропадает при
 * скролле»), и он прав по сути: навигация и главное действие сайта обязаны
 * оставаться в досягаемости, а кадр в файле — это один экран без прокрутки,
 * то есть состояния «прокручено» он не описывает вовсе.
 *
 * Размытие подложки 8 px — оттуда же. Одной прозрачности мало: текст страницы,
 * проезжающий под полосой, читается сквозь неё и спорит с навигацией. Размытие
 * оставляет цветовое пятно и убирает буквы. Значение маленькое сознательно —
 * это подложка, а не матовое стекло.
 *
 * Про кнопку. Сам компонент `x5cd2F` в файле набран 17/600 с полем 28, а его
 * инстанс в шапке переопределён на 15/600 с полем 20. Лестница сайта закрыта
 * ступенями 48/17 и 28/13, поэтому от lg здесь стоит ступень, а не
 * переопределение: иначе у одной и той же кнопки было бы два кегля на одном
 * экране. Ниже lg взят замер телефона — см. `compact` в `SiteButton.astro`:
 * там это вопрос не вкуса, а ширины экрана.
 *
 * Раскрытого меню в файле нет ни в одном кадре — есть только значок. Панель
 * собрана из уже существующего языка подвала: те же ссылки 15/500 `text-2`
 * через зазор 12, панель радиусом 16 из пары «высота — радиус». Это
 * достроенное состояние, а не замер, и оно названо вслух.
 *
 * Активного пункта в файле тоже нет: на всех семи кадрах сайта обе ссылки
 * шапки набраны одинаково — 15/500 `text-2`, включая кадр «Тарифы», где
 * человек стоит на «Тарифах». Это решение владельца против файла, и оно
 * названо здесь. Отличие собрано из того же языка, а не из нового приёма:
 * цвет `fg` вместо `text-2` и начертание 600 вместо 500 — обе ступени уже
 * ходят по сайту парой «громко/тихо». Ни подчёркивания, ни плашки, ни точки
 * не заводится: активный пункт — это не шестой контрол, а тот же текст в
 * своём сильном варианте. `aria-current="page"` ставится вместе с цветом,
 * иначе для экранного диктора страница остаётся неопознанной.
 */
import { Menu, X } from 'lucide-react'

import BrandMark from './BrandMark.astro'
import SiteButton from './SiteButton.astro'
import SiteMobileBar from './SiteMobileBar.astro'
import { isActiveRoute, signupHref, siteRoutes } from '@/lib/site-routes'

interface Props {
  /**
   * Подпись раздела для мобильной полосы 56. Обязательна везде, кроме
   * главной: без неё полоса вышла бы пустой, а пустая полоса выглядит как
   * рабочая и потому не была бы замечена ни на одном просмотре.
   */
  caption?: string
}

const { caption } = Astro.props

const navigation = [
  { href: siteRoutes.howItWorks, label: 'Как это устроено' },
  { href: siteRoutes.pricing, label: 'Тарифы' },
]

const pathname = Astro.url.pathname

// Оболочка выбирается адресом, а не свойством: два свойства (одно у шапки,
// другое у подвала) разъехались бы на первой же новой странице, и разъезд был
// бы виден только на телефоне.
const isHome = isActiveRoute(pathname, siteRoutes.home)

// Забытая подпись — ошибка сборки, а не пустая полоса на телефоне. Сборка
// зелёная при мёртвой разметке уже подводила этот проект; здесь она обязана
// падать.
if (!isHome && !caption) {
  throw new Error(
    `SiteHeader: у страницы ${pathname} нет подписи раздела для мобильной полосы 56. ` +
      'Подпись берётся из мобильного кадра страницы в Pencil и передаётся свойством caption.',
  )
}

// Одна функция на оба ряда ссылок — в шапке и в раскрывающемся меню: иначе
// пункт подсветился бы на широком экране и остался бы немым на телефоне.
//
// `hv-nav` — подчёркивание, которое растёт от левого края при наведении. Это
// отклик на курсор, а не метка активной страницы: активный пункт по-прежнему
// отличается только цветом и начертанием (см. шапку файла). Правило живёт под
// `@media (hover: hover)`, поэтому на телефоне подчёркивания не существует.
const navLinkClasses = (href: string) => [
  'ctl ctl-text hv-nav text-15 transition-colors duration-150',
  isActiveRoute(pathname, href) ? 'font-semibold text-fg' : 'font-medium text-text-2',
]
---

{/* Полоса 56 вместо шапки на всех страницах, кроме главной. Ниже lg на экране
    ровно один ориентир `banner`: у второго `display: none`. */}
{
  !isHome && caption && (
    <div class="lg:hidden">
      <SiteMobileBar caption={caption} />
    </div>
  )
}

<header
  class:list={[
    'sticky top-0 z-50 border-b border-hairline bg-bg/72 backdrop-blur-[8px]',
    isHome ? '' : 'hidden lg:block',
  ]}
>
  {/* Зазор 24 — гаттер сетки: в файле ряд разложен space-between без зазора,
      но на узком экране колонкам нужно за что-то держаться. */}
  {/* Зазор 12 ниже lg — не из файла, а из арифметики: в замере ряд разложен
      space-between без зазора, и на 390 между марком и правой группой остаётся
      63 px воздуха. Зазор здесь работает только как нижний предел на узких
      экранах, где этого воздуха нет. */}
  <div class="site-container flex h-14 items-center justify-between gap-3 lg:h-16 lg:gap-6">
    <a class="ctl rounded-sm" href={siteRoutes.home} aria-label="Сёрчь, на главную">
      <BrandMark dot={7} dotLg={8} />
    </a>

    <nav class="hidden items-center gap-7 lg:flex" aria-label="Основная навигация">
      {
        navigation.map((item) => (
          <a
            class:list={navLinkClasses(item.href)}
            aria-current={isActiveRoute(pathname, item.href) ? 'page' : undefined}
            href={item.href}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2.5">
      {/* Ниже 360 призыв уходит из полосы в меню. Мобильный кадр набран на 390,
          и его собственный ряд требует 327 px содержимого: марка 72 + призыв
          161 + зазор 10 + кнопка меню 44. На 320 это не помещается ни при
          какой вёрстке, а рвать метку на две строки или дать странице
          горизонтальную прокрутку хуже, чем один раз переложить действие
          туда, где оно всё равно есть. */}
      <span class="max-[359px]:hidden">
        <SiteButton compact href={signupHref} label="Создать агентство" />
      </span>

      {/* Раскрывашка, а не кнопка со скриптом: `details` открывается и с
          клавиатуры, и без JS, поэтому меню работает даже на странице,
          где скрипт не загрузился. Скрипт ниже добавляет к ней ровно то,
          чего у `details` нет по природе: фокус-трап, блокировку фона,
          закрытие по `Esc` и по щелчку мимо.

          Меню есть только на главной, и это не оптимизация. Ниже lg на
          остальных страницах шапки нет вовсе, а от lg меню и так скрыто
          вёрсткой, — то есть вне главной оно не показывается ни на одной
          ширине. Скрытая, но живая раскрывашка ловила бы `Tab` и читалась
          бы диктором, ничего при этом не открывая. */}
      {isHome && (
      <details class="group relative lg:hidden" data-menu>
        <summary
          class="ctl ctl-text flex size-11 cursor-pointer list-none items-center justify-center rounded-md text-fg [&::-webkit-details-marker]:hidden"
          aria-expanded="false"
          aria-label="Меню сайта"
        >
          <Menu className="size-6 group-open:hidden" aria-hidden="true" />
          <X className="hidden size-6 group-open:block" aria-hidden="true" />
        </summary>

        <nav
          class="absolute right-0 top-full z-10 mt-3 flex w-56 flex-col gap-3 rounded-2xl border border-hairline bg-surface p-4"
          aria-label="Основная навигация"
          data-menu-panel
        >
          {
            navigation.map((item) => (
              <a
                class:list={navLinkClasses(item.href)}
                aria-current={isActiveRoute(pathname, item.href) ? 'page' : undefined}
                href={item.href}
              >
                {item.label}
              </a>
            ))
          }

          <div class="hidden flex-col max-[359px]:flex">
            <SiteButton compact href={signupHref} label="Создать агентство" />
          </div>
        </nav>
      </details>
      )}
    </div>
  </div>
</header>

<script>
  // Бургер-меню. Машина состояния остаётся у `details`: он открывается без JS
  // и с клавиатуры, поэтому меню работает и на странице, где скрипт не
  // загрузился. Скрипт добавляет то, чего у `details` нет по природе.
  //
  // 1. Фокус-трап. Пока меню открыто, `Tab` ходит по кольцу «кнопка → пункты →
  //    кнопка». Без этого фокус уезжает в призыв шапки за спиной открытого
  //    меню, и человек с клавиатурой не понимает, где он.
  // 2. Блокировка фона. Страница под меню не прокручивается (`data-menu-open`
  //    на `html`), а всё, что вне шапки, получает `inert`: экранный диктор не
  //    читает содержимое, закрытое меню.
  // 3. `Esc` и щелчок мимо закрывают меню и возвращают фокус на кнопку.
  //
  // Само раскрытие — fade + slide 250 мс, объявлено в `global.css` анимацией:
  // переход с `display: none` не стартует, а `details` отдаёт панель именно
  // оттуда.
  const menu = document.querySelector<HTMLDetailsElement>('[data-menu]')
  const summary = menu?.querySelector('summary')
  const panel = menu?.querySelector<HTMLElement>('[data-menu-panel]')

  if (menu && summary && panel) {
    // Фон — соседи шапки по `body` (пропуск к содержанию, `main`, подвал).
    // Саму шапку выключать нельзя: в ней и живёт открытое меню.
    const background = Array.from(document.body.children).filter(
      (element) => !element.contains(menu)
    )

    const wide = window.matchMedia('(min-width: 1024px)')

    const close = () => {
      if (!menu.open) return
      menu.open = false
      summary.focus()
    }

    const sync = () => {
      const open = menu.open
      summary.setAttribute('aria-expanded', String(open))
      document.documentElement.toggleAttribute('data-menu-open', open)
      for (const element of background) element.toggleAttribute('inert', open)
    }

    menu.addEventListener('toggle', sync)

    menu.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        close()
        return
      }

      if (event.key !== 'Tab' || !menu.open) return

      // Список считается на каждом нажатии: призыв внутри панели появляется
      // только ниже 360 px, и зафиксированный при инициализации список
      // промахнулся бы мимо него.
      // Отрисованные — то же правило, что у стаггера: узел из `display:none`
      // никогда не станет `activeElement`, поэтому кольцо на нём разрывается,
      // и фокус уходит за спину открытого меню — на вордмарк и призыв шапки.
      // Ровно это и ломало трап: призыв внутри панели живёт только ниже 360 px.
      const stops: HTMLElement[] = [
        summary,
        ...panel.querySelectorAll<HTMLElement>('a[href], button:not([disabled])'),
      ].filter((node) => node.getClientRects().length > 0)
      const first = stops[0]
      const last = stops[stops.length - 1]
      const edge = event.shiftKey ? first : last

      if (document.activeElement === edge) {
        event.preventDefault()
        ;(event.shiftKey ? last : first).focus()
      }
    })

    // Щелчок мимо закрывает. Слушаем нажатие, а не щелчок: закрытие обязано
    // происходить в тот же момент, что и остальной отклик интерфейса.
    document.addEventListener('pointerdown', (event) => {
      if (!menu.open) return
      if (event.target instanceof Node && menu.contains(event.target)) return
      close()
    })

    // На широком экране меню скрыто вёрсткой. Если оно осталось открытым,
    // блокировка фона пережила бы своё меню: страница не прокручивалась бы,
    // а виновника на экране не видно.
    wide.addEventListener('change', () => {
      if (wide.matches) close()
    })

    sync()
  }
</script>
