---
/**
 * Итоговое действие — `Q9O7S` на «Законе и данных» (тот же блок стоит и на
 * главной, `XhMfF`). Поля 200 сверху и снизу, внутри колонка 792 по центру.
 *
 * Заливка двухслойная: фотография в режиме `fill` и поверх неё сплошная завеса
 * `scrim-photo` (#1e1e1e при 65 %). Без завесы белый текст на фотографии не
 * проходит порог контраста ни при какой удаче с кадром — DESIGN.md разбирает
 * это отдельно. Текст на фотографии всегда чистый белый: иерархию здесь даёт
 * кегль, а не прозрачность.
 *
 * Кнопка — та же ступень 48, но рангом `on-photo`: графитовая заливка в завесе
 * не читается, поэтому цвета меняются местами.
 *
 * Адрес фотографии взят прямо из файла: собственных ассетов у сайта нет, все
 * снимки в Pencil — прямые ссылки на Unsplash.
 *
 * Телефон — узел `wUTP4` внутри «МОБАЙЛ · Главная» (`EDoek`): поля 96 сверху и
 * снизу вместо 200, призыв растянут на всю ширину колонки. Заголовок берёт
 * ступень 40, подзаголовок и правовая строка не меняются.
 *
 * Колонка на телефоне не плоская. Заголовок стоит сам по себе, а подзаголовок,
 * кнопка и правовая строка собраны в «Группу действия» (`AJR8q`): между
 * заголовком и группой 28, внутри группы 12. Плоские 24, которыми блок жил
 * раньше, давали на телефоне лишний воздух под кнопкой и недостаточный над
 * заголовком — то есть ни одного из двух замеров. От lg колонка остаётся
 * плоской: 24 на главной, 28 на «Законе».
 */
import SiteButton from './SiteButton.astro'

interface Props {
  title: string
  subtitle: string
  action: { href: string; label: string }
  /** Правовая строка под кнопкой. */
  legal: string
  /** Зазор колонки: 28 на «Законе», 24 на главной. Обе меры из файла. */
  gap?: 28 | 24
  photo: string
}

const { action, gap = 28, legal, photo, subtitle, title } = Astro.props
---

<section class="relative isolate overflow-hidden py-24 lg:py-50">
  <div
    class="absolute inset-0 -z-20 bg-cover bg-center"
    style={`background-image: url("${photo}")`}
    aria-hidden="true"
  >
  </div>
  <div class="absolute inset-0 -z-10 bg-scrim-photo" aria-hidden="true"></div>

  <div class="site-container flex flex-col items-center">
    {/* Шаг 120: последнее высказывание страницы, и оно выходит той же
        расстановкой, что врез в начале. Проявляется только колонка с текстом,
        фотография и завеса остаются на месте — иначе движение получила бы
        подложка во всю ширину экрана, а не сам призыв. */}
    {/* Колонка остаётся плоской из четырёх узлов на обеих ширинах: очередь
        reveal нумерует ПРЯМЫХ детей группы, и обёртка «Группы действия»
        превратила бы четыре такта в два. Поэтому граница группы размечена
        отступом на подзаголовке, а не контейнером: 12 держит зазор внутри
        группы, лишние 16 добирают 28 до заголовка. От lg отступ снимается и
        работает один зазор колонки. */}
    <div
      class:list={[
        'flex max-w-[792px] flex-col items-center gap-3 text-center',
        gap === 24 ? 'lg:gap-6' : 'lg:gap-7',
      ]}
      data-rev-group
      data-rev-step="120"
    >
      <h2 class="text-40 font-semibold text-on-photo lg:text-52">{title}</h2>
      <p class="text-17 mt-4 font-medium text-on-photo lg:mt-0">{subtitle}</p>
      {/* Колонка растягивает ссылку на всю ширину, `block` от lg возвращает ей
          собственную: на телефоне призыв занимает колонку целиком. */}
      <div class="flex w-full flex-col lg:block lg:w-auto">
        <SiteButton href={action.href} label={action.label} variant="on-photo" />
      </div>
      <p class="text-13 font-medium text-on-photo">{legal}</p>
    </div>
  </div>
</section>
