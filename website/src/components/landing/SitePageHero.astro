---
/**
 * Первый экран страницы-раздела — `uynrI` на «Тарифах» и `ur4mO` на
 * «Законе и данных». Один и тот же скелет: колонка 690, заголовок в две-три
 * строки 66/600, подзаголовок шириной 600, строка доверия шириной 560.
 *
 * Вертикальные зазоры в Pencil заданы пустыми распорками (26 · 36 · 18), а не
 * одним `gap`. Здесь они собраны вложенными колонками, чтобы зазор оставался
 * свойством контейнера, а не отступом на каждом элементе: внешняя колонка
 * держит 36, верхняя группа — 26 между заголовком и подзаголовком, нижняя —
 * 18 между кнопкой и строкой доверия. Без кнопки нижняя группа схлопывается
 * в один элемент, и остаются ровно те же 26 и 36, что на «Тарифах».
 *
 * Нижнее поле экрана разное: 96 на «Тарифах», 72 на «Законе», 64 на блоге,
 * «О компании», «Контактах» и на трёх правовых страницах — «Политике»
 * (`wASjr`), «Согласии» (`uolBJ`) и «Оферте» (`OzhLX`). Все три меры сняты,
 * поэтому это проп, а не среднее между ними.
 *
 * Телефон — «Заголовок» в кадрах `gpcCa` (Тарифы), `RbWlq` (Закон), `j1bD09`
 * (Оферта) и их двойниках: там первый экран страницы это не экран, а первый
 * блок тела — заголовок 26/600 и лид 15/500 через 10, без собственных полей.
 * Ритм задаёт тело страницы: поля 24 сверху, 32 снизу и зазор 24 между
 * блоками. Поэтому 96 · 72 · 64 и ступень 66 живут только от lg, а на телефоне
 * заголовок берёт 26 — ту же ступень, которой набраны заголовки всех секций.
 *
 * Строки доверия в мобильном первом экране нет вовсе: «Заголовок» там ровно
 * два узла. Тот же текст стоит последней строкой страницы сноской 12/500
 * `text-dense` — см. свойство `trustFootnote`.
 *
 * Промежуточной ступени 52 больше нет: планшета у сайта нет как решения, и на
 * 768–1024 отдаётся мобильная раскладка (см. `global.css`). Кегль, живущий
 * только в этой полосе, был бы ступенью без экрана.
 */
import SiteButton from './SiteButton.astro'

interface TitleLine {
  text: string
  /** Последняя строка заголовка бывает набрана `text-2`, а не `fg`. */
  muted?: boolean
}

interface Props {
  titleLines: TitleLine[]
  subtitle: string
  trust: string
  /** Кнопка есть на «Законе» и нет на «Тарифах». */
  action?: { href: string; label: string }
  /** Нижнее поле экрана в пикселях по замеру страницы. */
  bottom?: 96 | 72 | 64
  /**
   * Ниже lg строка доверия уходит из первого экрана в конец страницы.
   *
   * На мобильных кадрах она набрана не 13/500 в шапке, а 12/500 `text-dense`
   * последней строкой тела: «Тарифы» кончаются сноской `okjec`, «Закон» —
   * `BxXIc`. Сноску рисует сама страница: у первого экрана нет доступа к её
   * последнему блоку, а строка обязана стоять именно там, после вопросов.
   *
   * Свойство, а не общее правило: замер снят на «Тарифах» и «Законе», и
   * пока переведены не все страницы, тихо менять остальные нельзя.
   */
  trustFootnote?: boolean
  /**
   * Пара цен между лидом и кнопкой — **только на телефоне и только здесь**.
   *
   * На кадре `RGNeD` внутри «МОБАЙЛ · Закон и данные» стоят «199 ₽ за
   * раскрытый контакт» и «3 000 ₽ в месяц за агентство»; на десктопном
   * `pRvKS` их нет вовсе, как нет и на мобильном «Как это устроено».
   *
   * Причина продуктовая: на телефоне «Тарифы» — это ещё одно касание и уход
   * со страницы, и человек, читающий про закон, до них не дойдёт. Цена,
   * названная до кнопки, снимает вопрос «сколько это стоит» там, где он
   * возникает.
   */
  prices?: { sum: string; note: string }[]
  /**
   * Надзаголовок — **только на телефоне**.
   *
   * На кадре `eZAoT` над заголовком разбора стоит «22 ИЮЛЯ · ДАННЫЕ РЫНКА»,
   * на десктопном `shmRc` его нет. Причина видна, если открыть оба: на 1440
   * человек попадает в статью из списка, где категория и дата стояли рядом
   * с карточкой. На 390 список остался далеко наверху, и статья обязана
   * сама сказать, что это за материал и когда он вышел.
   */
  kickerSm?: string
}

const {
  action,
  kickerSm,
  prices,
  bottom = 96,
  subtitle,
  titleLines,
  trust,
  trustFootnote = false,
} = Astro.props

// Отображение, а не цепочка тернарников: ступеней уже три, и четвёртая
// добавляется строкой, а не переписыванием условия.
const bottomClass = { 96: 'lg:pb-24', 72: 'lg:pb-18', 64: 'lg:pb-16' } as const
---

<section class:list={['pt-6 pb-3 lg:pt-24', bottomClass[bottom]]}>
  <div class="site-container">
    {/* Reveal идёт по двум группам файла — «заголовок с подзаголовком» и
        «действие со строкой доверия», — а не по каждому абзацу: распорки 26 и
        18 внутри этих групп уже говорят, что это два блока, а не четыре. */}
    <div class="flex max-w-[690px] flex-col gap-6 lg:gap-9" data-rev-group>
      <div class="flex flex-col gap-2.5 lg:gap-6.5">
        {kickerSm && (
          <p class="text-label-sm font-semibold text-text-dense lg:hidden">{kickerSm}</p>
        )}
        <h1 class="text-26 font-semibold text-fg lg:text-66">
          {
            titleLines.map((line) => (
              <span class:list={['block', line.muted ? 'text-text-2' : '']}>{line.text}</span>
            ))
          }
        </h1>
        <p class="text-15 max-w-[600px] font-medium text-text-2 lg:text-17">{subtitle}</p>
      </div>

      {
        prices && (
          <div class="flex items-start gap-6 lg:hidden">
            {prices.map((price) => (
              <div class="flex flex-col gap-0.5">
                <span class="text-20 font-semibold text-fg">{price.sum}</span>
                <span class="text-13 font-medium text-text-2">{price.note}</span>
              </div>
            ))}
          </div>
        )
      }

      {/* Ниже lg вторая группа целиком уходит из раскладки, а не прячет один
          абзац: `display: none` не даёт зазора колонки, поэтому 24 после лида
          не остаются висеть пустотой. */}
      <div
        class:list={[
          'flex-col items-start gap-6 lg:flex lg:gap-4.5',
          trustFootnote && !action ? 'hidden' : 'flex',
        ]}
      >
        {action && <SiteButton href={action.href} label={action.label} />}
        <p
          class:list={[
            'max-w-[560px] text-13 font-medium text-text-2',
            trustFootnote ? 'hidden lg:block' : '',
          ]}
        >
          {trust}
        </p>
      </div>
    </div>
  </div>
</section>
