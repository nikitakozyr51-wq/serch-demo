---
/**
 * Вордмарк «Сёрчь»: слово 20/600 и красная точка через зазор 8.
 *
 * Точка — единственное место, где живёт яркий `accent-bright`: текста на ней
 * нет, поэтому контраст ей не нужен. Красным на сайте больше не заливается
 * ничего, кроме списания денег.
 *
 * Размер точки в файле разный: в шапке `zB5U7` — 8×8, в подвале `ffD1a` — 9×9,
 * на служебных страницах — эллипс 6×6. Мобильные кадры добавили ещё две меры:
 * шапка `AcWMe` — 7×7, подвал `W8o1CK` — 8×8. Все пять мер настоящие; сводить
 * их к одной — решение владельца, а не догадка исполнителя.
 *
 * Форма у шестёрки другая, и это не оплошность замера: 7, 8 и 9 — прямоугольники
 * с радиусом 2, а 6 в кадрах `C2Fnim`, `z0bYqe`, `LMsWf` — настоящий эллипс.
 * На малом размере скруглённый квадрат перестаёт читаться как форма, поэтому
 * точка там круглая.
 *
 * `dotLg` нужен там, где замер телефона и замер десктопа расходятся на пиксель:
 * это не «плавный размер», а две снятые меры, каждая на своей ширине.
 *
 * Зазор «слово — точка» тоже не один. В шапке `zB5U7` (8), в подвале `W8o1CK`
 * (8) и в десктопной шапке служебных страниц `nTJVE` (8) он равен восьми, и
 * марка выходит 71–73 px. В мобильной полосе 56 `zpsSi` зазор шесть, и марка
 * выходит ровно 69 (57 + 6 + 6). Шесть пикселей вместо восьми — это замер, а
 * не округление: полоса 56 на телефоне живёт с подписью раздела в одной
 * строке, и марка в ней собрана теснее.
 */
interface Props {
  dot?: 6 | 7 | 8 | 9
  dotLg?: 8 | 9
  /** Зазор «слово — точка». Шесть — только в мобильной полосе 56. */
  gap?: 6 | 8
}

const { dot = 8, dotLg, gap = 8 } = Astro.props

const dots = {
  6: 'size-1.5 rounded-full',
  7: 'size-[7px] rounded-bar',
  8: 'size-2 rounded-bar',
  9: 'size-[9px] rounded-bar',
} as const

const dotsLg = {
  8: 'lg:size-2',
  9: 'lg:size-[9px]',
} as const

const gaps = { 6: 'gap-1.5', 8: 'gap-2' } as const
---

<span class:list={['inline-flex items-center', gaps[gap]]}>
  <span class="text-20 font-semibold text-fg">Сёрчь</span>
  <span
    class:list={['bg-accent-bright', dots[dot], dotLg ? dotsLg[dotLg] : '']}
    aria-hidden="true"></span>
</span>
