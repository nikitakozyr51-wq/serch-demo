---
/**
 * САЙТ · Политика обработки данных — кадр `wASjr`, 1440×1697.
 *
 * Шапка → первый экран → разделы политики → подвал. Ни одного собственного
 * блока: страница целиком собрана из готовых частей сайта, и это правильно —
 * правовая страница не место для новой формы.
 *
 * Разделы набраны тем же блоком, что и вопросы на «Тарифах» и «Законе»:
 * в файле у них те же строки с полями 24, та же волосная линия сверху, тот же
 * значок 20 — `minus` у раскрытых, `plus` у свёрнутых. Пятая строка получает
 * ещё и нижнюю линию, замкнув список.
 *
 * Раскрыты первые два раздела, и это не случайность вёрстки: раздел 2 — тот,
 * ради которого собственник сюда и приходит, и лид слева прямо отправляет
 * его туда. У свёрнутых трёх текста ответа в файле нет, поэтому строка стоит
 * обычной строкой, а не раскрывашкой в пустоту.
 *
 * Title и description взяты из спецификации `СИСТЕМА · Индексация и
 * метаданные`, где эта страница числится открытой для индексации.
 */
import SiteFaq from '@/components/landing/SiteFaq.astro'
import type { FaqItem } from '@/components/landing/SiteFaq.astro'
import SiteFooter from '@/components/landing/SiteFooter.astro'
import SiteHeader from '@/components/landing/SiteHeader.astro'
import SitePageHero from '@/components/landing/SitePageHero.astro'
import BaseLayout from '@/layouts/BaseLayout.astro'

const title = 'Политика обработки персональных данных — Сёрчь'
const description =
  'Какие данные обрабатываем и на каком основании. Как узнать источник своего номера и потребовать удаления.'

const publicWebsiteUrl = import.meta.env.PUBLIC_WEBSITE_URL
const canonicalUrl = publicWebsiteUrl
  ? new URL(Astro.url.pathname, publicWebsiteUrl).toString()
  : undefined

const sections: FaqItem[] = [
  {
    question: '1. Какие данные мы обрабатываем и на каком основании',
    open: true,
    answer:
      'Из открытых объявлений мы берём телефон размещателя, адрес объекта, параметры квартиры, цену и даты публикации. Основание обработки: заключение и исполнение договора с пользователем сервиса, а также законный интерес в объёме, не нарушающем права субъекта.',
  },
  {
    question: '2. Как узнать источник своего номера и потребовать удаления',
    open: true,
    answer:
      'На странице serch.ru/data по номеру телефона мы показываем площадку, номер объявления, дату публикации и дату последней проверки. На serch.ru/stop номер исключается из сервиса за минуту, снять исключение не может ни агентство, ни поддержка.',
  },
  // Три последних раздела в Pencil свёрнуты, текста ответа у них нет.
  { question: '3. Сроки хранения и порядок удаления' },
  { question: '4. Кому мы передаём данные' },
  { question: '5. Как мы защищаем данные' },
]
---

<BaseLayout canonicalUrl={canonicalUrl} description={description} title={title}>
  {/* Подпись мобильной полосы 56 — замер кадра `F8asuT`. */}
  <SiteHeader caption="политика 152-ФЗ" />

  <main id="main-content">
    <SitePageHero
      titleLines={[{ text: 'Политика' }, { text: 'обработки данных' }]}
      subtitle="Как мы собираем, храним и удаляем персональные данные. Редакция от 12 июня 2026 года."
      trust="Оператор персональных данных, уведомление в Роскомнадзор № 78-19-004182. Серверы в Российской Федерации."
      bottom={64}
    />

    <SiteFaq
      title="Разделы политики"
      lead="Если вы собственник и хотите узнать, откуда у нас ваш номер, начните с раздела 2."
      items={sections}
      dense
    />
  </main>

  <SiteFooter />
</BaseLayout>
