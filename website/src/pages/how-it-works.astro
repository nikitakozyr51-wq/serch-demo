]

// Воронка первого раздела `u91G5Q`: четыре ступени между двумя линиями.
const funnel = [
  { value: '1 240', caption: 'объявлений за сутки' },
  { value: '630', caption: 'дублей склеено' },
  { value: '419', caption: 'посредников отсеяно' },
  { value: '191', caption: 'объект остаётся' },
]
---

<BaseLayout canonicalUrl={canonicalUrl} description={description} title={title}>
  {/* Подпись мобильной полосы 56 — замер кадра `FPwxu`. */}
  <SiteHeader caption="документация" />

  <main id="main-content">
    <DocPageHeader
      kicker="ДОКУМЕНТАЦИЯ · ОБНОВЛЕНО 24 ИЮЛЯ 2026"
      title="Как «Сёрчь» находит собственника"
      lead="Что происходит с объявлением от момента, когда его опубликовали на площадке, до строки в вашей выдаче. Без маркетинга: правила склейки, отсева и проверки, по которым это считается."
      leadSm="Что происходит с объявлением от публикации на площадке до строки в вашей выдаче. Без маркетинга: правила склейки, отсева и проверки."
    />

    <div class="pt-14 pb-24">
      <div class="site-container flex flex-col gap-12 lg:flex-row lg:gap-20">
        {/* Оглавление. В Pencil его пункты — просто текст, но список, который
            называется «на этой странице» и никуда не ведёт, это дефект, а не
            замер. Пункты сделаны ссылками на разделы. */}
        {/* Липкое: оглавление подсвечивает текущий раздел на прокрутке
            (`data-toc-link` ниже), а подсветка в уехавшем списке ничего не
            сообщает. `self-start` — иначе в ряду flex список растягивается
            на высоту статьи и липнуть ему нечем. */}
        <nav
          class="flex flex-col gap-3.5 lg:sticky lg:top-20 lg:w-60 lg:shrink-0 lg:self-start"
          aria-label="На этой странице"
          data-rev-group
        >
          <p class="text-label-sm font-semibold text-text-dense">НА ЭТОЙ СТРАНИЦЕ</p>
          {
            sections.map((section, index) => (
              <a
                class="ctl group flex gap-3 py-1.5"
                data-toc-link
                data-active={index === 0 ? 'true' : 'false'}
                href={`#${section.id}`}
              >
                <span class="text-13 font-semibold text-text-dense transition-colors duration-150 group-hover:text-fg group-data-[active=true]:text-fg">
                  {index + 1}
                </span>
                <span class="flex-1 text-13 font-medium text-text-2 transition-colors duration-150 group-hover:text-fg group-data-[active=true]:font-semibold group-data-[active=true]:text-fg">
                  {section.toc}
                </span>
              </a>
            ))
          }
        </nav>

        <div class="flex flex-col lg:w-[880px] lg:shrink-0">
          {
            sections.map((section, index) => (
              /* Каждый раздел проявляется сам по себе, а не общей очередью:
                 разделы длинные, в кадре их редко больше одного, и общий
                 стаггер выдал бы шестому разделу чужие 560 ms задержки —
                 человек ждал бы полсекунды на пустом экране. */
              <section
                id={section.id}
                class:list={[
                  'flex flex-col gap-5',
                  index === 0 ? 'pb-10' : 'border-t border-line-2 py-10',
                ]}
                data-rev-solo
              >
                <div class="flex items-start gap-4">
                  <span class="text-13 font-semibold text-text-dense">{index + 1}</span>
                  <h2 class="flex-1 text-26 font-semibold text-fg">{section.title}</h2>
                </div>

                {section.paragraphs.map((paragraph) =>
                  typeof paragraph === 'string' ? (
                    <p class="text-17-prose font-medium text-text-2">{paragraph}</p>
                  ) : (
                    <>
                      <p class="text-17-prose font-medium text-text-2 lg:hidden">
                        {paragraph.short}
                      </p>
                      <p class="text-17-prose hidden font-medium text-text-2 lg:block">
                        {paragraph.full}
                      </p>
                    </>
                  ),
                )}

                {index === 0 && (
                  /* Четыре равные ступени по 220. Сетка, а не `flex-1`: у гибкой
                     раскладки поле слева прибавляется к доле, и первая ступень
                     выходит на 25 px уже остальных. Колонка сетки считается от
                     ширины, поэтому поле съедает содержимое, как в файле. */
                  <div class="flex flex-col border-y border-line-2 lg:grid lg:grid-cols-4">
                    {funnel.map((step, stepIndex) => (
                      <div
                        class:list={[
                          'flex flex-col gap-1 py-5',
                          stepIndex > 0
                            ? 'border-t border-line-2 lg:border-t-0 lg:border-l lg:pl-6'
                            : '',
                        ]}
                      >
                        <span class="text-num-40 font-semibold text-fg">{step.value}</span>
                        <span class="text-13 font-medium text-text-dense">{step.caption}</span>
                      </div>
                    ))}
                  </div>
                )}

                {section.rule && (
                  <div class="flex flex-col gap-2 rounded-2xl bg-warm p-5">
                    <p class="text-label-sm font-semibold text-text-dense">ПРАВИЛО</p>
                    {typeof section.rule === 'string' ? (
                      <p class="text-15 font-medium text-fg">{section.rule}</p>
                    ) : (
                      <>
                        <p class="text-15 font-medium text-fg lg:hidden">{section.rule.short}</p>
                        <p class="text-15 hidden font-medium text-fg lg:block">
                          {section.rule.full}
                        </p>
                      </>
                    )}
                  </div>
                )}
              </section>
            ))
          }
        </div>
      </div>
    </div>

    <div class="border-t border-line-2 pt-8 pb-16">
      <div class="site-container flex flex-col gap-4 sm:flex-row sm:items-center" data-rev-group>
        <p class="text-15 font-medium text-text-2 sm:flex-1">
          Доступ к выдаче — 3 000 ₽ в месяц за агентство, раскрытие контакта — 199 ₽. Первые пять
          раскрытий бесплатно.
        </p>
        <a
          class="ctl ctl-ink text-15 self-start font-semibold text-fg transition-colors duration-150"
          href={signupHref}
        >
          Создать агентство
        </a>
      </div>
    </div>
  </main>

  <SiteFooter />
</BaseLayout>

<script>
  // Подсветка активного пункта оглавления. В Pencil страница снята на верхней
  // точке, поэтому в файле активен первый пункт; разметка приходит с сервера
  // ровно в этом состоянии. Без скрипта подсветка осталась бы на первом пункте
  // навсегда и врала бы читателю, который уже уехал в пятый раздел.
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]'))
  const sections = links
    .map((link) => document.getElementById(link.hash.slice(1)))
    .filter((section): section is HTMLElement => section !== null)

  if (sections.length === links.length && sections.length > 0) {
    const sync = () => {
      // Активен последний раздел, чей заголовок уже прошёл четверть экрана:
      // подсветка переключается тогда, когда раздел дошёл до зоны чтения,
      // а не когда он коснулся верхнего края окна.
      const line = window.innerHeight / 4
      let active = 0
      sections.forEach((section, index) => {
        if (section.getBoundingClientRect().top <= line) {
          active = index
        }
      })
      links.forEach((link, index) => {
        link.dataset.active = index === active ? 'true' : 'false'
      })
    }

    let scheduled = false
    const onScroll = () => {
      if (scheduled) return
      scheduled = true
      requestAnimationFrame(() => {
        scheduled = false
        sync()
      })
    }

    sync()
    window.addEventListener('scroll', onScroll, { passive: true })
    window.addEventListener('resize', onScroll, { passive: true })
  }
</script>
