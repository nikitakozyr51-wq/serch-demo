---
/**
 * САЙТ · Как это устроено — кадр `q01Vt`, 1440×3247.
 *
 * Документационная страница: шапка с меткой и датой обновления, тело из двух
 * колонок (оглавление 240 и содержание 880 через 80) и закрывающая строка.
 *
 * Здесь нет ни одной кнопки: единственное действие страницы — текстовая ссылка
 * в закрывающей строке. Так в файле, и это осмысленно: документацию читают,
 * а не покупают.
 */
import DocPageHeader from '@/components/landing/DocPageHeader.astro'
import SiteFooter from '@/components/landing/SiteFooter.astro'
import SiteHeader from '@/components/landing/SiteHeader.astro'
import BaseLayout from '@/layouts/BaseLayout.astro'
import { signupHref } from '@/lib/site-routes'

const title = 'Как «Сёрчь» находит собственника — Сёрчь'
const description =
  'Что происходит с объявлением от момента, когда его опубликовали на площадке, до строки в вашей выдаче: правила склейки, отсева и проверки.'

const publicWebsiteUrl = import.meta.env.PUBLIC_WEBSITE_URL
const canonicalUrl = publicWebsiteUrl
  ? new URL(Astro.url.pathname, publicWebsiteUrl).toString()
  : undefined

interface DocSection {
  id: string
  /** Название в оглавлении: у шестого раздела оно короче заголовка. */
  toc: string
  title: string
  /**
   * Абзац раздела.
   *
   * Строка — один и тот же текст на обеих ширинах. Пара `{ full, short }` —
   * разные редакции: **на телефоне текст в файле переписан короче, а не
   * перенесён**. «от момента, когда его опубликовали на площадке» на 390
   * становится «от публикации на площадке», «Цена берётся самая низкая
   * из найденных, а остальные показываются рядом, чтобы было видно, кто
   * накинул» — «Цена берётся самая низкая, остальные показываются рядом —
   * видно, кто накинул».
   *
   * Это решение файла, а не вольность вёрстки: на 390 длинный абзац
   * превращается в семь строк, и человек его пролистывает. Короткая
   * редакция сохраняет смысл и умещается в три.
   *
   * Обе редакции лежат в разметке, лишняя скрыта `display: none` —
   * диктору достаётся ровно одна.
   */
  paragraphs: (string | { full: string; short: string })[]
  /** Блок «ПРАВИЛО» есть не у каждого раздела. */
  /** Плашка «ПРАВИЛО». На телефоне у одного из разделов она короче — как в файле. */
  rule?: string | { full: string; short: string }
}

const sections: DocSection[] = [
  {
    id: 'otkuda-berutsya-obekty',
    toc: 'Откуда берутся объекты',
    title: 'Откуда берутся объекты',
    paragraphs: [
      {
        full: 'Четыре площадки — Авито, Циан, Домклик и Яндекс — обходятся круглосуточно. Берутся только объявления о продаже квартир по Санкт-Петербургу и только те поля, которые опубликовал сам размещатель: телефон, адрес, параметры, цена и даты.',
        short: 'Четыре площадки — Авито, Циан, Домклик и Яндекс — обходятся круглосуточно. Берутся только объявления о продаже квартир по Петербургу и только те поля, которые опубликовал сам размещатель.',
      },
      {
        full: 'За сутки приходит 1 240 новых объявлений. Ниже показано, что от этого числа остаётся после трёх фильтров.',
        short: 'За сутки приходит 1 240 новых объявлений. Ниже — что от них остаётся после трёх фильтров.',
      },
    ],
  },
  {
    id: 'kak-skleivaetsya-dubl',
    toc: 'Как склеивается дубль',
    title: 'Как склеивается дубль',
    paragraphs: [
      {
        full: 'Одна квартира висит на нескольких площадках под разными телефонами и с разной ценой. Пока они считаются четырьмя объявлениями, агент обзванивает один объект четыре раза и трижды попадает на посредника.',
        short: 'Одна квартира висит на нескольких площадках под разными телефонами и с разной ценой. Пока это четыре объявления, агент обзванивает один объект четыре раза и трижды попадает на посредника.',
      },
      {
        full: 'Склейка сводит их в один объект. Цена берётся самая низкая из найденных, а остальные показываются рядом, чтобы было видно, кто накинул.',
        short: 'Склейка сводит их в один объект. Цена берётся самая низкая, остальные показываются рядом — видно, кто накинул.',
      },
    ],
    rule: 'Дубль: совпали адрес, площадь, этаж и не меньше двух фотографий.',
  },
  {
    id: 'kak-otseivaetsya-posrednik',
    toc: 'Как отсеивается посредник',
    title: 'Как отсеивается посредник',
    paragraphs: [
      {
        full: 'Посредник выдаёт себя повторами: один и тот же номер стоит под объявлениями по разным адресам. Второй признак даёт сама площадка, помечая объявление агентским.',
        short: 'Посредник выдаёт себя повторами: один номер под объявлениями по разным адресам. Второй признак даёт сама площадка, помечая объявление агентским.',
      },
      {
        full: 'Отсев происходит до того, как объект попадёт в выдачу. Поэтому в выдаче не бывает строки, за которую заплатили и получили агентство.',
        short: 'Отсев происходит до выдачи. Поэтому в ней не бывает строки, за которую заплатили и получили агентство.',
      },
    ],
    rule: 'Посредник: номер встречается больше чем в трёх объявлениях по разным адресам либо помечен площадкой как агентский.',
  },
  {
    id: 'kak-proveryaetsya-nomer',
    toc: 'Как проверяется номер',
    title: 'Как проверяется номер',
    paragraphs: [
      {
        full: 'Оставшиеся объекты проверяются заново: висит ли объявление и жив ли номер. Дата последней проверки видна в карточке объекта и на странице serch.ru/data, куда может зайти сам собственник.',
        short: 'Оставшиеся объекты проверяются заново: висит ли объявление и жив ли номер. Дата последней проверки видна в карточке и на serch.ru/data, куда может зайти сам собственник.',
      },
      {
        full: 'Если объявление сняли, объект уходит из выдачи при следующей проверке, а не остаётся висеть месяцами.',
        short: 'Если объявление сняли, объект уходит из выдачи при следующей проверке.',
      },
    ],
  },
  {
    id: 'chto-proishodit-pri-raskrytii',
    toc: 'Что происходит при раскрытии',
    title: 'Что происходит при раскрытии',
    paragraphs: [
      {
        full: 'Раскрытие — единственное платное действие. Поиск, фильтры, подборки и повторный просмотр уже раскрытого контакта не стоят ничего.',
        short: 'Раскрытие — единственное платное действие. Поиск, фильтры, подборки и повторный просмотр раскрытого контакта не стоят ничего.',
      },
      {
        full: '199 ₽ уходят со счёта агентства в момент нажатия. Одновременно появляется запись в журнале доступа: кто, когда и по какому объекту. Запись не удаляется — она нужна, чтобы ответить собственнику, откуда у агента его номер.',
        short: '199 ₽ уходят со счёта агентства в момент нажатия. Одновременно появляется запись в журнале доступа: кто, когда и по какому объекту. Она не удаляется — нужна, чтобы ответить собственнику.',
      },
      {
        full: 'Если попался посредник, возврат оформляется кнопкой в панели фиксации звонка. Объективная причина закрывается сразу, субъективная в течение часа.',
        short: 'Если попался посредник, возврат оформляется кнопкой в панели фиксации звонка.',
      },
    ],
    rule: 'Выгрузка номеров пачкой недоступна никому, включая руководителя агентства.',
