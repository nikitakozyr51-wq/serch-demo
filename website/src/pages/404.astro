---
/**
 * САЙТ · 404 — кадры `mEcGL` (1440×1024) и `gKAga` (390×722).
 *
 * Имя файла задано Astro, а не нами: `src/pages/404.astro` — единственное
 * место, откуда фреймворк берёт страницу для несуществующего адреса. Доска
 * `СИСТЕМА · Индексация и метаданные` называет тот же адрес `serch.ru/404`.
 *
 * Панель справа отвечает на вопрос, который человек задаёт после «страницы
 * нет»: а куда тогда. Три строки — не меню сайта, а три входа, которыми
 * собственник и риелтор пользуются по-настоящему. Адреса в панели набраны
 * текстом, а не ссылками: так они стоят в файле, и так их можно переписать
 * с чужого экрана на бумажку — ровно тот способ, каким сюда и приходят.
 *
 * Код ответа. Спецификация требует, чтобы страница отдавала именно 404, а не
 * 200. При статической сборке это делает хостинг: Astro кладёт `404.html`, и
 * статические хостинги отдают его с кодом 404 сами. Проверять это надо на
 * хостинге, а не в исходниках.
 *
 * Страница закрыта от индексации по той же доске: «404 отдаёт код 404,
 * страница работ — 503 с Retry-After», обе в списке закрытых. Title там не
 * задан, поэтому взята подпись из шапки самого кадра.
 */
import ServicePage from '@/components/landing/ServicePage.astro'
import type { ServiceRow } from '@/components/landing/ServicePage.astro'
import { siteRoutes } from '@/lib/site-routes'

const rows: ServiceRow[] = [
  {
    term: 'serch.ru/stop',
    text: 'Исключить свой номер из сервиса. Без регистрации, нужен только код из SMS.',
  },
  {
    term: 'serch.ru/data',
    text: 'Узнать, откуда у нас ваш номер: площадка, объявление, дата публикации и проверки.',
  },
  {
    term: 'serch.ru',
    text: 'Главная страница: что делает сервис, сколько стоит и по каким правилам работает.',
  },
]
---

<ServicePage
  action={{ href: siteRoutes.home, label: 'На главную' }}
  caption="страница не найдена"
  captionSm="страница не найдена"
  heading="Такой страницы нет"
  lead="Возможно, ссылка устарела или в адресе опечатка. Если вы шли по ссылке на подборку, попросите агента прислать её заново: подборки живут ограниченное время."
  legal="Если вы искали страницу отказа от звонков, она живёт по адресу serch.ru/stop."
  panel={{
    label: 'КУДА МОЖНО ПОЙТИ',
    rows,
    note: 'Если нужна помощь человека, напишите на hello@serch.ru.',
  }}
  robots="noindex, nofollow"
  title="Страница не найдена — Сёрчь"
/>

{/*
  Глубокая ссылка в кабинет не должна упираться в «страницы нет».

  Кабинет — одностраничное приложение: все его адреса рисует браузер, а на
  диске лежит один `app/index.html`. Статический хостинг об этом не знает и
  на `/app/search` честно отдаёт 404. Поэтому 404 сам возвращает человека
  в кабинет, передав адрес, куда он шёл, — кабинет откроет нужный экран.

  Обычные адреса сайта этим кодом не затрагиваются: он срабатывает только
  внутри `/app/`. Человек, ошибшийся в адресе страницы сайта, видит
  нормальную страницу «Такой страницы нет», а не прыжок в кабинет.
*/}
<script is:inline define:vars={{ base: import.meta.env.BASE_URL }}>
  const prefix = `${base.replace(/\/+$/, '')}/app/`
  const { pathname, search, hash } = window.location

  if (pathname.startsWith(prefix) && pathname !== prefix) {
    const target = pathname.slice(prefix.length - 1) + search + hash
    window.location.replace(`${prefix}?p=${encodeURIComponent(target)}`)
  }
</script>
