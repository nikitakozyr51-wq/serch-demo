---
/**
 * ПУБЛИЧНОЕ · serch.ru/stop — кадры `H83QZ` (1440×1024) и `V9ILWs` (390×1050).
 *
 * Страница отказа от звонков. Собственник приходит сюда с бумажки: адрес
 * напечатан прямо в тексте на «Законе и данных» — «на serch.ru/stop номер
 * исключается за минуту», — и на неё же ссылается «Данные удалены». До этой
 * сборки обе ссылки вели в никуда, то есть обещание, которым сервис
 * оправдывается перед 152-ФЗ, не работало.
 *
 * Каркас общий со служебными страницами (`ServicePage`), добавлена только
 * форма из двух полей. Форма собрана формой, а не двумя полями и ссылкой:
 * иначе не будет ни отправки по Enter, ни автозаполнения, ни связи метки с
 * полем для экранного диктора.
 *
 * Метод POST: номер телефона и код из SMS не должны попадать в адресную
 * строку, в историю браузера и в логи. Адрес обработчика ещё не задан —
 * бэкенд формы не подключён, и это единственное, чего здесь не хватает до
 * рабочего состояния. Следующий шаг собран: `/podtverdite-nomer`.
 *
 * Лид и правовая строка взяты в полном, широкоэкранном виде. На телефонном
 * кадре у обеих отрезан хвост — «Больше ничего не потребуется» у лида и
 * «и к ст. 10.1 152-ФЗ» у правовой, — но это не разные подписи, а одна и та
 * же мысль, укороченная под высоту артборда. Обещание собственнику не может
 * быть разным на разных устройствах, поэтому текст один; на телефоне он
 * занимает на строку больше.
 *
 * Страница открыта для индексации — единственная из четырёх служебных.
 * Так на доске `СИСТЕМА · Индексация и метаданные`: чужих данных на ней нет,
 * а найти её поиском собственник должен. Title и description оттуда же.
 */
import PublicField from '@/components/landing/PublicField.astro'
import ServicePage from '@/components/landing/ServicePage.astro'
import type { ServiceRow } from '@/components/landing/ServicePage.astro'

const title = 'Убрать мой номер из Сёрчь — отказ от звонков агентств'
const description =
  'Одно поле и код по SMS. Номер скрывается у всех пользователей за минуту. Снять отказ не может ни агентство, ни поддержка.'

const publicWebsiteUrl = import.meta.env.PUBLIC_WEBSITE_URL
const canonicalUrl = publicWebsiteUrl
  ? new URL(Astro.url.pathname, publicWebsiteUrl).toString()
  : undefined

const rows: ServiceRow[] = [
  {
    term: 'Сразу',
    text: 'Номер скрыт у всех пользователей сервиса. Раскрыть его больше нельзя, деньги за прошлые раскрытия возвращены агентствам.',
  },
  {
    term: '3 рабочих дня',
    text: 'Номер убран из активной выдачи и из всех сохранённых поисков.',
  },
  {
    term: '30 дней',
    text: 'Номер и связанные с ним записи удалены. Останется только отметка в стоп-листе, чтобы он не появился снова.',
  },
]
---

<ServicePage
  action={{ label: 'Исключить номер' }}
  canonicalUrl={canonicalUrl}
  caption="serch.ru/stop · публичная страница"
  captionSm="serch.ru/stop"
  description={description}
  heading="Уберите мой номер"
  lead="Я собственник, я не хочу звонков по своему объявлению. Введите номер, придёт код подтверждения. Больше ничего не потребуется."
  legal="Мы не спрашиваем, кто вы и на каком основании владеете объектом. Проверка права собственности стала бы барьером, а барьер на отказе это прямой путь к жалобе в Роскомнадзор и к ст. 10.1 152-ФЗ."
  legalSm="Мы не спрашиваем, кто вы и на каком основании владеете объектом. Проверка права собственности стала бы барьером, а барьер на отказе это прямой путь к жалобе в Роскомнадзор."
  panel={{
    label: 'ЧТО ПРОИЗОЙДЁТ',
    rows,
    note: 'Снять отказ нельзя ни агенту, ни руководителю агентства, ни поддержке. Если вы передумаете, напишите на dpo@serch.ru с того же номера.',
  }}
  title={title}
>
  <Fragment slot="fields">
    <PublicField
      id="phone"
      label="ВАШ НОМЕР ТЕЛЕФОНА"
      name="phone"
      placeholder="+7 900 000-23-72"
      type="tel"
      inputmode="tel"
      autocomplete="tel"
      hint="тот, который указан в объявлении"
      dense
    />
    <PublicField
      id="code"
      label="КОД ИЗ SMS"
      name="code"
      placeholder="Введите четыре цифры"
      type="text"
      inputmode="numeric"
      autocomplete="one-time-code"
      hint="код придёт в течение минуты, повторная отправка через 60 секунд"
      dense
    />
  </Fragment>
</ServicePage>
