---
/**
 * САЙТ · Статус сервиса — кадры `M8UCn` (1440×1024) и `olXfz` (390×750).
 *
 * Адрес `/status` стоит в подвале и на доске `СИСТЕМА · Индексация и
 * метаданные` («serch.ru/status», открыта для индексации). В шапке самого
 * кадра при этом напечатан поддомен «status.serch.ru» — файл спорит сам с
 * собой. Владелец поставил страницу на `/status`, поэтому в подписи стоит
 * `/status`: подпись шапки существует затем, чтобы человек знал, где он.
 *
 * Данные на странице — из файла и статические: «4 минуты назад», «512 новых
 * объявлений». Живого источника у сайта нет, и придумывать его здесь нельзя:
 * страница статуса, показывающая выдуманные цифры, хуже её отсутствия. До
 * подключения источника это витрина, а не мониторинг, и это названо вслух.
 *
 * Лид обещает «историю за девяносто дней ниже», а ниже в файле ничего нет —
 * ни на 1440, ни на 390. Текст оставлен как в файле, потому что придумывать
 * график за девяносто дней запрещено тем же правилом; недостающий кусок —
 * дыра файла, а не перевода.
 *
 * «Подписаться на сбои» ведёт на почту: подписки как механизма в продукте нет
 * ни одного кадра, а `hello@serch.ru` — единственный канал связи, который на
 * сайте объявлен, и тем же адресом уже пользуется «Спросить о договоре» в
 * прайсе.
 */
import ServicePage from '@/components/landing/ServicePage.astro'
import type { ServiceRow } from '@/components/landing/ServicePage.astro'

const title = 'Статус сервиса Сёрчь и площадок-источников'
const description =
  'Состояние Авито, Циана, Домклика и Яндекса. Обновляется каждую минуту, история за девяносто дней.'

const publicWebsiteUrl = import.meta.env.PUBLIC_WEBSITE_URL
const canonicalUrl = publicWebsiteUrl
  ? new URL(Astro.url.pathname, publicWebsiteUrl).toString()
  : undefined

const rows: ServiceRow[] = [
  {
    term: 'Авито',
    text: 'Работает. Последняя выгрузка 4 минуты назад, за сутки 512 новых объявлений.',
  },
  {
    term: 'Циан',
    text: 'Работает. Последняя выгрузка 7 минут назад, за сутки 388 новых объявлений.',
  },
  {
    term: 'Домклик и Яндекс',
    text: 'Домклик работает, последняя выгрузка 11 минут назад. Яндекс отдаёт данные с задержкой около часа с 02:40.',
  },
]
---

<ServicePage
  action={{ href: 'mailto:hello@serch.ru', label: 'Подписаться на сбои' }}
  canonicalUrl={canonicalUrl}
  caption="serch.ru/status · публичная страница"
  captionSm="serch.ru/status · публичная страница"
  description={description}
  heading="Всё работает"
  lead="Состояние сервиса и площадок-источников. Обновляется каждую минуту, история за девяносто дней ниже."
  legal="Мы публикуем сбои сами, до того как о них спросят. Если площадка перестала отдавать объявления, это видно здесь раньше, чем в выдаче."
  panel={{
    label: 'ИСТОЧНИКИ',
    rows,
    note: 'Задержка одной площадки не останавливает выдачу: объект попадает в неё по любому из четырёх источников.',
  }}
  title={title}
/>
