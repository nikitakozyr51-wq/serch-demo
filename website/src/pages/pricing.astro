---
/**
 * САЙТ · Тарифы — кадр `O01pc`, 1440×2749.
 *
 * Порядок сверху вниз ровно как в файле: шапка → первый экран (без кнопки) →
 * тарифы → вопросы → подвал.
 *
 * Телефон — кадр `gpcCa`, 390×2640, и это не та же страница поуже. Вместо
 * шапки полоса 56 с подписью «тарифы», подвала нет вовсе, а тело — одна
 * колонка с полями [24, 16, 32, 16] и зазором 24 между блоками:
 *
 *   заголовок → прайс → «Больше двадцати» → шапка вопросов → вопросы → сноска
 *
 * Отличий от десктопа, снятых замером, четыре, и все они здесь:
 *   1. Шапки блока прайса («Что входит в каждый рубль» с лидом) на телефоне
 *      нет: страница уже названа заголовком первого экрана, и второй заголовок
 *      про то же самое файл не рисует.
 *   2. Секция прайса своих полей не имеет — 12 сверху и снизу складываются с
 *      соседями ровно в зазор 24. Тот же приём уже стоит в `SiteFaq` (`dense`).
 *   3. Плашка «Больше двадцати» на телефоне другая: поле 16 вместо 32, радиус
 *      16 вместо 24, зазор 12 вместо 32, заголовок 17/600 вместо 20/600,
 *      текст 13/500 вместо 15/500, а действие — залитая кнопка во всю ширину
 *      вместо обведённой по содержанию.
 *   4. Строка «Работаем с юридическими лицами по договору» уходит из первого
 *      экрана в конец страницы и набирается 12/500 `text-dense` (`okjec`).
 */
import PricePlates from '@/components/landing/PricePlates.astro'
import SiteButton from '@/components/landing/SiteButton.astro'
import SiteFaq from '@/components/landing/SiteFaq.astro'
import type { FaqItem } from '@/components/landing/SiteFaq.astro'
import SiteFooter from '@/components/landing/SiteFooter.astro'
import SiteHeader from '@/components/landing/SiteHeader.astro'
import SitePageHero from '@/components/landing/SitePageHero.astro'
import BaseLayout from '@/layouts/BaseLayout.astro'

// Заголовка вкладки и описания для поиска в Pencil нет — там только содержание
// страницы. Оба собраны из её же слов, ничего нового не придумано.
const title = 'Тарифы — Сёрчь'
const description =
  'Доступ для всего агентства и оплата за каждый раскрытый контакт. Объекты, которые агент не раскрыл, не стоят ничего.'

const publicWebsiteUrl = import.meta.env.PUBLIC_WEBSITE_URL
const canonicalUrl = publicWebsiteUrl
  ? new URL(Astro.url.pathname, publicWebsiteUrl).toString()
  : undefined

// Один и тот же текст стоит в двух местах разметки и ни в одном — на обеих
// ширинах сразу: от lg это строка доверия первого экрана, ниже lg — сноска
// в конце страницы. Константа держит их согласованными.
const trust = 'Работаем с юридическими лицами по договору. Счёт и акт приходят первого числа.'

const faqItems: FaqItem[] = [
  {
    question: 'Что входит в 3 000 ₽ в месяц?',
    open: true,
    answer:
      'Доступ для всего агентства, до двадцати сотрудников: выдача, фильтры, сохранённые поиски, подборки для клиентов, антидубль, отметка «кто из коллег уже звонил», история звонков и экраны руководителя. Раскрытие контактов оплачивается отдельно.',
  },
  {
    question: 'За что списывается 199 ₽?',
    open: true,
    answer:
      'За раскрытие контакта собственника. Повторного списания по тому же объекту не бывает: если номер уже открывал коллега, кнопка так и подписана, «бесплатно, раскрыт коллегой 12.07». Выдача, фильтры и подборки денег не стоят.',
  },
  // Свёрнуто в файле — это состояние строки, а не отсутствие ответа. Оба
  // текста ниже повторяют правила, уже прописанные на сайте: условия возврата
  // — в ответе про посредника выше, судьба раскрытых контактов — в разделе
  // про отключённого сотрудника. Новых обещаний здесь не появляется.
  {
    question: 'Когда возвращаются 199 ₽?',
    answer:
      'Когда по номеру ответил не собственник. Возврат отмечается кнопкой в панели фиксации звонка, а не письмом в поддержку: объективные причины — номер посредника, номер не существует, объект продан — закрываются сразу, спорные разбираются в течение часа. Лимит — двенадцать возвратов за тридцать дней на агентство.',
  },
  {
    question: 'Что будет, если не продлить подписку?',
    answer:
      'Выдача и раскрытие контактов закрываются, а всё, за что уже заплачено, остаётся: раскрытые номера, подборки, статусы объектов и история звонков видны и после окончания подписки. Деньги на балансе не сгорают и ждут продления.',
  },
]
---

<BaseLayout canonicalUrl={canonicalUrl} description={description} title={title}>
  {/* Подпись мобильной полосы 56 — замер кадра `gpcCa`. */}
  <SiteHeader caption="тарифы" />

  <main id="main-content">
    <SitePageHero
      titleLines={[{ text: 'Одна цена,' }, { text: 'два числа' }]}
      subtitle="Доступ для всего агентства и оплата за каждый раскрытый контакт. Объекты, которые агент не раскрыл, не стоят ничего."
      trust={trust}
      trustFootnote
    />

    <section class="py-3 lg:py-35">
      <div class="site-container flex flex-col items-center gap-6 lg:gap-14">
        {/* Группа только на шапке блока: у плашек своя очередь внутри
            `PricePlates`, а строка расширенного доступа выходит сама по себе —
            вложенный reveal ждал бы пересечения уже внутри уезжающего
            родителя.

            Ниже lg шапки нет: страница уже названа заголовком первого экрана.
            Скрыта вёрсткой, а не вырезана, — на широком экране возвращается. */}
        <div
          class="hidden max-w-[640px] flex-col items-center gap-4 text-center lg:flex"
          data-rev-group
        >
          <h2 class="text-40 font-semibold text-fg">Что входит в каждый рубль</h2>
          <p class="text-17 font-medium text-text-2">
            Доступ для агентства и оплата за каждый раскрытый контакт.
          </p>
        </div>

        <PricePlates />

        {/* Второй тариф `KkySp`: тёплая плашка, а не четвёртая колонка прайса.
            Расширенный доступ покупают переговорами, поэтому он стоит отдельной
            строкой и действие у него вторичное.

            На телефоне (`JKqez`) плашка плотнее и тише: поле 16, радиус 16,
            зазор 12, заголовок 17/600, текст 13/500. */}
        <div
          class="flex w-full flex-col gap-3 rounded-2xl bg-warm p-4 lg:flex-row lg:items-center lg:gap-8 lg:rounded-3xl lg:p-8"
          data-rev-solo
        >
          <div class="flex flex-1 flex-col gap-2">
            <h3 class="text-17 font-semibold text-fg lg:text-20">Больше двадцати сотрудников</h3>
            <p class="text-13 max-w-[760px] font-medium text-text-2 lg:text-15">
              Расширенный доступ: 6 000 ₽ в месяц до пятидесяти человек. Цена по-прежнему за
              агентство целиком, а не за сотрудника, поэтому двадцать первый и пятидесятый стоят
              одинаково. Раскрытия считаются так же, по 199 ₽.
            </p>
          </div>
          {/* Ранг действия на двух ширинах разный, и оба ранга из файла: на
              телефоне (`OOqbD`) кнопка залита `fg` и растянута на всю ширину —
              это единственное действие блока на экране; от lg (`VkXHh`) она
              обведена и по содержанию, потому что стоит рядом с прайсом, где
              главные действия уже залиты. Ранг несёт заливка, и одной ссылкой
              двух заливок не бывает, поэтому здесь два узла, из которых на
              каждой ширине отрисован ровно один. */}
          <div class="flex flex-col lg:hidden">
            <SiteButton href="mailto:hello@serch.ru" label="Спросить о расширенном" width="full" />
          </div>
          <div class="hidden lg:block">
            <SiteButton
              href="mailto:hello@serch.ru"
              label="Спросить о расширенном"
              variant="secondary"
            />
          </div>
        </div>
      </div>
    </section>

    <SiteFaq
      title="Вопросы, которые задают перед оплатой"
      lead="Про деньги: что входит в подписку, за что списывается и когда возвращается."
      items={faqItems}
      firstRule={false}
      dense
    />

    {/* Сноска `okjec`: последняя строка мобильного тела, 12/500 `text-dense`.
        От lg тот же текст стоит строкой доверия в первом экране, поэтому здесь
        он ниже lg и только здесь. Поля 12 сверху складываются с 12 снизу у
        блока вопросов в зазор 24, снизу 32 — нижнее поле тела страницы. */}
    <div class="site-container pt-3 pb-8 lg:hidden">
      <p class="text-12 font-medium text-text-dense">{trust}</p>
    </div>
  </main>

  <SiteFooter />
</BaseLayout>
