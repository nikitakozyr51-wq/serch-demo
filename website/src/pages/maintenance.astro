---
/**
 * САЙТ · Технические работы — кадры `C8nzz` (1440×1024) и `E7swy` (390×744).
 *
 * Адрес взят с доски `СИСТЕМА · Индексация и метаданные`: там страница стоит
 * строкой «serch.ru/404 · /maintenance». Ссылок на неё нет ни в шапке, ни в
 * подвале, и это правильно: её подставляет хостинг вместо всего сайта на
 * время работ, а не человек по меню.
 *
 * Код ответа. Спецификация требует 503 с заголовком `Retry-After`. Статическая
 * страница своего кода ответа не задаёт — это делает тот, кто её подставляет
 * (хостинг или обратный прокси). Здесь этого нет и быть не может, поэтому
 * названо вслух: без настройки на стороне хостинга поисковик получит 200 и
 * решит, что сайт теперь такой.
 *
 * Кнопка «Обновить страницу» — обычная ссылка на этот же адрес. Не кнопка со
 * скриптом: страница технических работ обязана работать без JavaScript, потому
 * что показывают её ровно тогда, когда всё остальное не работает.
 *
 * Страница закрыта от индексации той же строкой доски. Title там не задан,
 * поэтому взято название страницы из спецификации.
 */
import ServicePage from '@/components/landing/ServicePage.astro'
import type { ServiceRow } from '@/components/landing/ServicePage.astro'
import { siteRoutes } from '@/lib/site-routes'

const rows: ServiceRow[] = [
  {
    term: 'Работает',
    text: 'Уже раскрытые контакты и подборки, отправленные клиентам. Ссылки не ломаются.',
  },
  {
    term: 'Не работает',
    text: 'Поиск, выдача, раскрытие контактов и пополнение баланса.',
  },
  {
    term: 'Не пострадает',
    text: 'Стоп-лист исполняется всё это время: номера из отказов не отдаются ни при каких условиях.',
  },
]
---

<ServicePage
  action={{ href: siteRoutes.maintenance, label: 'Обновить страницу' }}
  caption="технические работы"
  captionSm="технические работы"
  heading="Сервис недоступен около часа"
  lead="Обновляем сбор данных с площадок. Поиск и раскрытие контактов сейчас не работают, деньги за это время не списываются."
  legal="Работы начались в 03:10 и закончатся к 04:15 по московскому времени. Если к 05:00 ничего не изменилось, напишите на hello@serch.ru."
  panel={{
    label: 'ЧТО ПРИ ЭТОМ РАБОТАЕТ',
    rows,
    /*
     * В файле здесь напечатано «status.serch.ru», но доска индексации даёт той
     * же странице адрес `serch.ru/status`, и владелец поставил её на `/status`.
     * Файл спорит сам с собой; оставить в тексте поддомен значило бы отправить
     * человека на несуществующий адрес прямо со страницы про поломку, поэтому
     * взят адрес, по которому страница действительно живёт.
     */
    note: 'Состояние сервиса и история сбоев: serch.ru/status.',
  }}
  robots="noindex, nofollow"
  title="Технические работы — Сёрчь"
/>
