# Подключение кабинета к базе.
#
# Оба значения — из настроек проекта Supabase (Project Settings → API).
# Без них кабинет работает из браузера: так собрана демонстрация на GitHub
# Pages, где сервера нет и быть не может.
#
# Для локальной базы значения печатает `npx supabase start` в корне репозитория.
#
# Ключ `service_role` в этот файл не попадает никогда: он обходит все правила
# доступа, а всё, что здесь лежит, уезжает в браузер.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
